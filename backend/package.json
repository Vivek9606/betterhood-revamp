{
  "name": "betterhood-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Visitor journey tracking API + internal analytics dashboard for betterhood.in",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "geoip-lite": "^2.0.3",
    "hono": "^4.13.14",
    "postgres": "^3.4.9",
    "tsx": "^4.23.15",
    "ua-parser-js": "^1.0.41",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/ua-parser-js": "^0.7.39",
    "typescript": "^7.0.2"
  }
}

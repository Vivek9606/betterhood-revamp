# Supabase Postgres. Use the "Session pooler" string from Supabase → Project Settings → Database → Connect
# (the direct db.<ref>.supabase.co host is IPv6-only and Railway can't reach it).
# URL-encode special characters in the password (+ → %2B, @ → %40, # → %23).
DATABASE_URL=postgresql://postgres.ltokeuseaidwrocakhys:<password>@aws-1-eu-west-3.pooler.supabase.com:5432/postgres

PORT=8787

# Sites allowed to send events (comma-separated)
ALLOWED_ORIGINS=http://localhost:4321,https://betterhood.in,https://www.betterhood.in

# Login for /dashboard
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { media, contact } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  type?: "website" | "article" | "profile";
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  published?: string;
  modified?: string;
  overlayHeader?: boolean;
}
const {
  title,
  description = "Physio-trusted pain care for everyday movement. Physio co-created supports, recovery essentials, free pain assessments and 1000+ expert articles from betterhood.",
  // a real 1200x630 card, not the square site icon, for pages that don't bring their own image
  image = "/img/og-home.jpg",
  imageAlt,
  imageWidth,
  imageHeight,
  type = "website",
  noindex = false,
  jsonLd,
  published,
  modified,
  overlayHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = /betterhood/i.test(title) ? title : `${title} | betterhood`;
const ogImage = new URL(media(image), Astro.site).href;
const isDefaultImage = image === "/img/og-home.jpg";
const ogW = imageWidth ?? (isDefaultImage ? 1200 : undefined);
const ogH = imageHeight ?? (isDefaultImage ? 630 : undefined);
const ogAlt = imageAlt ?? (isDefaultImage ? "betterhood: physio trusted pain care for everyday movement" : title);
// let search engines show large image previews and full snippets (as the old site did)
const robots = noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://betterhood.in/#organization",
  name: "betterhood",
  alternateName: "betterhood India",
  legalName: "Agebetter Solutions Private Limited",
  url: "https://betterhood.in/",
  // raster logo: Google needs at least 112x112 and doesn't reliably read SVG
  logo: { "@type": "ImageObject", "@id": "https://betterhood.in/#logo", url: "https://betterhood.in/img/logo-512.png", width: 512, height: 512, caption: "betterhood" },
  image: { "@id": "https://betterhood.in/#logo" },
  email: contact.email,
  telephone: "+91-8484805885",
  address: { "@type": "PostalAddress", streetAddress: "1st Floor, 52, SPD Plaza, 4th A Cross Road, Near Jyothi Nivas College, Koramangala", addressLocality: "Bengaluru", addressRegion: "Karnataka", postalCode: "560034", addressCountry: "IN" },
  contactPoint: { "@type": "ContactPoint", contactType: "customer support", telephone: "+91-8484805885", email: contact.email, areaServed: "IN", availableLanguage: ["en", "hi"] },
  sameAs: ["https://www.instagram.com/betterhood.in", "https://www.youtube.com/@mybetterhood", "https://www.linkedin.com/company/betterhood-in/", "https://www.facebook.com/betterhood.in", "https://shop.betterhood.in/"],
};
const ld = [org, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---
<!doctype html>
<html lang="en-IN" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="bh-base" content="/" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <!-- Search Console ownership, carried over from the WordPress site -->
    <meta name="google-site-verification" content="Il0Pk39ULwalCrcSHFWuNXrABaKa_BVzk6xP6Vjhs2I" />
    <meta name="theme-color" content="#fbf7f1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:site_name" content="betterhood" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {ogW && <meta property="og:image:width" content={String(ogW)} />}
    {ogH && <meta property="og:image:height" content={String(ogH)} />}
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,300..800&family=Figtree:ital,wght@0,400..700;1,400..600&display=swap" />

    <script is:inline>document.documentElement.classList.remove("no-js")</script>
    <!-- Embed mode: the Betterhood app opens shared flows (assessments, directory listing) in an in-app frame
         with ?embed=app&origin=<app origin>. Hide the site chrome; src/scripts/embed.ts talks to the app. -->
    <script is:inline>
      (function () {
        if (window.parent === window) return;
        var d = document.documentElement, o = null, q = new URLSearchParams(location.search);
        if (q.get("embed") === "app") o = q.get("origin") || "";
        try { if (o !== null) sessionStorage.setItem("bh_embed", o); else o = sessionStorage.getItem("bh_embed"); } catch (e) {}
        if (o === null) return;
        d.classList.add("embed");
        if (/^(https?|capacitor|ionic):\/\/[^\/?#]+$/.test(o)) d.dataset.embedOrigin = o;
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      import "../scripts/forms";
      import "../scripts/motion-site";
    </script>
  </body>
</html>

  "age": {
    "title": "[[b]]Most People Wait[[/b]] Too Long",
    "sub": "Pain shows up differently at every age. Most people ignore the early signs until it’s much harder to reverse.",
    "intro": "Here is what your body is most vulnerable [[b]]to and [[/b]][[i]]when.[[/i]]",
    "decades": [
      {
        "age": "20s",
        "title": "Posture problems begin",
        "text": "Tech neck, wrist strain and poor desk habits start building the foundation for chronic pain."
      },
      {
        "age": "30s",
        "title": "The decade it shows up",
        "text": "Lower back pain, knee issues and repetitive strain become hard to ignore for the first time."
      },
      {
        "age": "40s",
        "title": "Compensation kicks in",
        "text": "Your body starts compensating for old injuries. What feels manageable starts limiting how you move."
      },
      {
        "age": "50s+",
        "title": "Chronic becomes daily",
        "text": "Arthritis, spondylosis and joint degeneration peak. By then, lasting damage is harder to reverse."
      }
    ],
    "outro": {
      "title": "Catch the [[b]]Signs [[/b]][[i]]Early[[/i]]",
      "text": "Find out how your musculoskeletal health is doing before small issues become chronic problems.",
      "cta": {
        "label": "Begin Assessment",
        "href": "/quiz-landing-page/"
      }
    }
  },

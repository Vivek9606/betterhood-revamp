---
// Learn hub — same sections, copy, posts and links as https://betterhood.in/learn/ (see REVAMP-GUIDELINES.md).
// Page copy comes from src/data/learn.json (npm run scrape:learn); post lists follow the live page's rules:
//   featured  = the post the live banner points at        trending   = latest 3
//   grid      = every post, newest first, 9 per load       must knows = latest 10 tagged "Absolute Must Knows"
//   expert    = every post tagged "Expert Section"
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import L from "../../data/learn.json";
import { posts, postsIn, isVideo, type Post } from "../../lib/data";
import { media } from "../../lib/site";

type Part = { t: string; light?: boolean; sup?: boolean };
const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
// the live page prints "September 26, 2026" (and "Sep 26, 2026" in What's Trending); read the date part only so
// the build machine's time zone can't shift it
const fmt = (iso: string, short = false) => {
  const [y, m, d] = iso.slice(0, 10).split("-").map(Number);
  const mon = MONTHS[m - 1];
  return `${short ? mon.slice(0, 3) : mon} ${d}, ${y}`;
};
const thumb = (p: Post) => p.image?.thumb || p.image?.src || (p.videos[0] ? `https://i.ytimg.com/vi/${p.videos[0]}/hqdefault.jpg` : "");

const featured = posts.find((p) => p.slug === L.featured.slug) ?? posts[0];
const trending = posts.slice(0, L.trending.count);
const first = posts.slice(0, L.browse.perPage);
const mustKnows = postsIn("post-section-tags", "absolute-must-knows").slice(0, L.mustKnows.count);
const expert = postsIn("post-section-tags", "expert-section");

const site = "https://betterhood.in";
const url = `${site}/learn/`;
const item = (p: Post, i: number) => ({ "@type": "ListItem", position: i + 1, url: `${site}/learn/${p.slug}/`, name: p.title });
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${url}#webpage`,
    url,
    name: L.seo.title,
    description: L.seo.description,
    inLanguage: "en-IN",
    isPartOf: { "@type": "WebSite", "@id": `${site}/#website`, url: `${site}/`, name: "betterhood" },
    publisher: { "@id": `${site}/#organization` },
    primaryImageOfPage: featured.image ? { "@type": "ImageObject", url: new URL(media(featured.image.src), site).href } : undefined,
    breadcrumb: { "@id": `${url}#breadcrumb` },
    hasPart: [
      { "@type": "ItemList", name: "What’s Trending", itemListElement: trending.map(item) },
      { "@type": "ItemList", name: "Absolute Must Knows by betterhood", itemListElement: mustKnows.map(item) },
      {
        "@type": "ItemList",
        name: L.expert.heading.map((p) => p.t).join(""),
        author: { "@type": "Person", name: L.expert.name, jobTitle: L.expert.roles[0]?.replace(/, betterhood$/, ""), description: L.expert.roles.join(". "), worksFor: { "@id": `${site}/#organization` }, image: new URL(media(L.expert.image), site).href },
        itemListElement: expert.map(item),
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: L.breadcrumb[0], item: `${site}/` },
      { "@type": "ListItem", position: 2, name: L.breadcrumb[1], item: url },
    ],
  },
];
const socialIcon = (href: string) => (/linkedin/.test(href) ? "linkedin" : /instagram/.test(href) ? "instagram" : /youtube/.test(href) ? "youtube" : "facebook");
const socialName = (href: string) => ({ linkedin: "LinkedIn", instagram: "Instagram", youtube: "YouTube", facebook: "Facebook" })[socialIcon(href)];
---
<Base title={L.seo.title} description={L.seo.description} image={featured.image?.src} jsonLd={jsonLd}>
  <h1 class="sr-only">{L.breadcrumb[1]}</h1>

  <!-- 1 · banner: featured post + newsletter + what's trending -->
  <section class="lb">
    <div class="wrap">
      <nav class="breadcrumbs lb-crumbs" aria-label="Breadcrumb">
        <a href="/">{L.breadcrumb[0]}</a><span aria-hidden="true">›</span><span aria-current="page">{L.breadcrumb[1]}</span>
      </nav>
      <div class="lb-grid">
        <article class="lf" data-reveal>
          <img class="lf-img" src={media(featured.image?.src ?? "")} alt={featured.image?.alt ?? ""} width={featured.image?.w ?? 1920} height={featured.image?.h ?? 1085} fetchpriority="high" decoding="async" />
          <div class="lf-shade" aria-hidden="true"></div>
          <div class="lf-body">
            <time class="lf-date" datetime={featured.date.slice(0, 10)}>{fmt(featured.date)}</time>
            <h2 class="lf-title"><a href={`/learn/${featured.slug}/`} class="lf-link">{featured.title}</a></h2>
            <div class="lf-foot">
              <span class="lf-by"><span class="lf-av" aria-hidden="true">b</span>{L.featured.byline}</span>
              <span class="btn btn-light lf-cta" aria-hidden="true">{L.featured.cta} <Icon name="arrow" class="arrow" /></span>
            </div>
          </div>
        </article>

        <aside class="la" aria-label="Newsletter and trending">
          <div class="la-nl">
            <h2 class="la-h" data-no-split>{(L.newsletterTop.heading as Part[]).map((p) => (p.light ? <span class="lt">{p.t}</span> : p.t))}</h2>
            <form class="la-form" data-bh-form="newsletter">
              <label class="sr-only" for="nl-top">{L.newsletterTop.placeholder}</label>
              <input id="nl-top" type="email" name="email" placeholder={L.newsletterTop.placeholder} required autocomplete="email" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
              <button class="btn btn-sm" type="submit">{L.newsletterTop.submit}</button>
              <p data-note hidden></p>
            </form>
          </div>
          <div class="la-tr">
            <h2 class="la-h" data-no-split>{(L.trending.heading as Part[]).map((p) => (p.light ? <span class="lt">{p.t.trim()} </span> : p.t))}</h2>
            <ol class="la-list">
              {trending.map((p) => (
                <li>
                  <a href={`/learn/${p.slug}/`}>
                    <span class="la-txt"><time datetime={p.date.slice(0, 10)}>{fmt(p.date, true)}</time><strong>{p.title}</strong></span>
                    <Icon name="arrow-up-right" size={20} class="la-go" />
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- 2 · browse: filters, type, search, grid -->
  <section class="lg" id="browse" aria-labelledby="browse-h">
    <h2 class="sr-only" id="browse-h">{L.browse.types[1]?.label}</h2>
    <div class="wrap lg-grid">
      <aside class="lg-side" id="filters" aria-label={L.browse.filterLabel}>
        <div class="lg-side-top">
          <button type="button" class="lg-reset" data-reset>{L.browse.reset}</button>
          <button type="button" class="lg-close" data-filters-close aria-label="Close"><Icon name="close" size={20} /></button>
        </div>
        {L.browse.groups.map((g) => (
          <fieldset class="lg-group" data-group={g.key}>
            <legend>{g.title}</legend>
            {g.terms.map((t) => (
              <label class="lg-opt">
                <input type="checkbox" value={t.value} />
                <span class="lg-ic">{t.icon && <img src={media(t.icon)} alt="" width="34" height="34" loading="lazy" />}</span>
                <span class="lg-lab">{t.label}</span>
                <span class="lg-box" aria-hidden="true"><Icon name="check" size={14} /></span>
              </label>
            ))}
          </fieldset>
        ))}
      </aside>
      <div class="lg-scrim" data-filters-close hidden></div>

      <div class="lg-main">
        <div class="lg-bar">
          <div class="lg-types" role="group" aria-label="Type" data-types>
            {L.browse.types.map((t, i) => <button type="button" aria-pressed={String(i === 0)} data-v={t.value}>{t.label}</button>)}
          </div>
          <button type="button" class="lg-ftoggle" aria-controls="filters" aria-expanded="false" data-filters-open><Icon name="filter" size={18} /> {L.browse.filterLabel}<span class="lg-fcount" data-fcount hidden></span></button>
          <form class="lg-search" role="search" onsubmit="return false">
            <Icon name="search" size={18} />
            <label class="sr-only" for="lg-q">{L.browse.searchLabel}</label>
            <input id="lg-q" type="search" placeholder={L.browse.searchPlaceholder} autocomplete="off" />
            <button type="button" class="lg-clear" data-clear hidden>{L.browse.clear}</button>
          </form>
        </div>
        <p class="sr-only" aria-live="polite" data-status></p>
        <div class="lg-cards" data-cards>
          {first.map((p, i) => (
            <article class="lc">
              <a href={`/learn/${p.slug}/`}>
                <span class="lc-img">
                  {thumb(p) && <img src={media(thumb(p))} alt={p.image?.alt ?? ""} width="768" height="432" loading={i < 3 ? "eager" : "lazy"} decoding="async" />}
                  {isVideo(p) && <span class="lc-play"><Icon name="play" size={16} /></span>}
                </span>
                <span class="lc-body"><time datetime={p.date.slice(0, 10)}>{fmt(p.date)}</time><h3>{p.title}</h3></span>
              </a>
            </article>
          ))}
        </div>
        <p class="lg-empty" data-empty hidden>Sorry, no content found.</p>
        <div class="lg-more"><button type="button" class="btn" data-more>{L.browse.loadMore}</button></div>
      </div>
    </div>
  </section>

  <!-- 3 · absolute must knows -->
  <section class="lm" aria-labelledby="mk-h">
    <div class="wrap">
      <div class="rail-head">
        <h2 class="rail-h" id="mk-h" data-no-split>{(L.mustKnows.heading as Part[]).map((p) => (p.sup ? <sup>{p.t}</sup> : p.light ? <span class="lt">{p.t}</span> : p.t))}</h2>
        <div class="rail-nav"><button type="button" data-prev="mk" aria-label="Previous" disabled><Icon name="arrow-left" size={20} /></button><button type="button" data-next="mk" aria-label="Next"><Icon name="arrow" size={20} /></button></div>
      </div>
    </div>
    <div class="rail" id="mk" tabindex="0" aria-label={(L.mustKnows.heading as Part[]).map((p) => p.t).join("")}>
      {mustKnows.map((p) => (
        <article class="lc lc-rail">
          <a href={`/learn/${p.slug}/`}>
            <span class="lc-img">{thumb(p) && <img src={media(thumb(p))} alt={p.image?.alt ?? ""} width="768" height="432" loading="lazy" decoding="async" />}</span>
            <span class="lc-body"><time datetime={p.date.slice(0, 10)}>{fmt(p.date)}</time><h3>{p.title}</h3></span>
          </a>
        </article>
      ))}
    </div>
  </section>

  <!-- 4 · insights from our expert -->
  <section class="le" aria-labelledby="ex-h">
    <div class="wrap">
      <div class="le-panel">
        <div class="rail-head">
          <h2 class="rail-h" id="ex-h" data-no-split>{(L.expert.heading as Part[]).map((p) => (p.light ? <span class="lt">{p.t}</span> : p.t))}</h2>
          <div class="rail-nav"><button type="button" data-prev="ex" aria-label="Previous" disabled><Icon name="arrow-left" size={20} /></button><button type="button" data-next="ex" aria-label="Next"><Icon name="arrow" size={20} /></button></div>
        </div>
        <div class="le-grid">
          <figure class="le-who">
            <img src={media(L.expert.image)} alt={L.expert.name} width="600" height="600" loading="lazy" decoding="async" />
            <figcaption>
              <strong class="le-name">{L.expert.name}</strong>
              <span class="le-role">{L.expert.roles[0]}</span>
              {L.expert.roles.slice(1).map((r) => <span class="le-sub">{r}</span>)}
            </figcaption>
          </figure>
          <div class="rail rail-in" id="ex" tabindex="0" aria-label={(L.expert.heading as Part[]).map((p) => p.t).join("")}>
            {expert.map((p) => (
              <article class="lc lc-rail">
                <a href={`/learn/${p.slug}/`}>
                  <span class="lc-img">{thumb(p) && <img src={media(thumb(p))} alt={p.image?.alt ?? ""} width="768" height="432" loading="lazy" decoding="async" />}</span>
                  <span class="lc-body"><time datetime={p.date.slice(0, 10)}>{fmt(p.date)}</time><h3>{p.title}</h3></span>
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5 · newsletter -->
  <section class="ln" aria-labelledby="nl-h">
    <div class="wrap">
      <div class="ln-panel">
        <div class="ln-copy">
          <h2 class="ln-h" id="nl-h" data-no-split>{(L.newsletter.heading as Part[]).map((p) => (p.light ? <span class="lt">{p.t}</span> : p.t))}</h2>
          <p>{L.newsletter.text}</p>
        </div>
        <div class="ln-act">
          <form class="ln-form" data-bh-form="newsletter">
            <label class="sr-only" for="nl-band">{L.newsletter.placeholder}</label>
            <input id="nl-band" type="email" name="email" placeholder={L.newsletter.placeholder} required autocomplete="email" />
            <input type="text" name="website" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
            <button class="btn btn-sun" type="submit">{L.newsletter.submit}</button>
            <p data-note hidden></p>
          </form>
          <ul class="ln-social">
            {L.socials.map((s) => (
              <li><a href={s.href} target="_blank" rel="noopener" aria-label={`betterhood on ${socialName(s.href)}`}><Icon name={socialIcon(s.href)} size={20} /></a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<template id="lc-tpl">
  <article class="lc"><a><span class="lc-img"><img width="768" height="432" loading="lazy" decoding="async" alt="" /></span><span class="lc-body"><time></time><h3></h3></span></a></article>
</template>

<style>
  .lt { font-weight: 300; }
  sup { font-size: 0.42em; font-weight: 400; margin-left: 0.08em; vertical-align: super; }

  /* ---------- 1 · banner ---------- */
  .lb { padding: clamp(18px, 3vw, 32px) 0 clamp(40px, 6vw, 72px); background: radial-gradient(80% 60% at 0% 0%, var(--plum-100), transparent 60%), radial-gradient(50% 50% at 100% 0%, var(--sun-100), transparent 70%); }
  .lb-crumbs { margin-bottom: 18px; }
  .lb-grid { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: clamp(20px, 2.4vw, 32px); align-items: stretch; }

  .lf { position: relative; isolation: isolate; overflow: hidden; border-radius: var(--r-xl); min-height: clamp(420px, 60vh, 600px); background: var(--plum-800); color: #fff; display: flex; }
  .lf-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; transition: transform 1.2s var(--ease); }
  .lf:hover .lf-img { transform: scale(1.035); }
  .lf-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(27, 8, 32, 0) 30%, rgba(27, 8, 32, 0.55) 62%, rgba(27, 8, 32, 0.9)); }
  .lf-body { align-self: flex-end; width: 100%; padding: clamp(22px, 3.4vw, 44px); display: grid; gap: 14px; }
  .lf-date { justify-self: start; padding: 6px 12px; border-radius: var(--r-pill); font-size: 13.5px; font-weight: 600; background: rgba(255, 255, 255, 0.16); backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.22); }
  .lf-title { font-size: clamp(28px, 3.6vw, 50px); line-height: 1.04; letter-spacing: -0.03em; max-width: 18ch; }
  .lf-link::after { content: ""; position: absolute; inset: 0; z-index: 1; border-radius: inherit; }
  .lf-link:focus-visible { outline: none; }
  .lf:has(.lf-link:focus-visible) { outline: 3px solid var(--sun-500); outline-offset: 3px; }
  .lf-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; margin-top: 6px; }
  .lf-by { display: inline-flex; align-items: center; gap: 10px; font-size: 15px; color: rgba(255, 255, 255, 0.85); }
  .lf-av { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--sun-500); color: var(--plum-950); font: 800 15px var(--font-display); }
  .lf-cta { pointer-events: none; }
  .lf:hover .lf-cta { transform: translateY(-2px); }
  .lf:hover .lf-cta :global(svg) { transform: translateX(3px); }

  .la { display: grid; grid-template-rows: auto 1fr; border-radius: var(--r-xl); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-md); overflow: hidden; }
  .la-nl { padding: 26px 26px 24px; background: linear-gradient(160deg, var(--plum-50), #fff); border-bottom: 1px solid var(--line); }
  .la-h { font-size: 24px; letter-spacing: -0.02em; margin-bottom: 14px; }
  .la-form { display: flex; gap: 6px; padding: 5px; border-radius: var(--r-pill); background: #fff; border: 1.5px solid var(--line-strong); transition: border-color 0.2s, box-shadow 0.2s; flex-wrap: wrap; }
  .la-form:focus-within { border-color: var(--plum-500); box-shadow: 0 0 0 4px var(--plum-100); }
  .la-form input[type="email"] { flex: 1; min-width: 0; border: 0; outline: 0; background: none; padding: 0 6px 0 14px; font-size: 15px; min-height: 38px; }
  .la-form [data-note], .ln-form [data-note] { flex-basis: 100%; padding: 4px 12px 2px; font-size: 13.5px; }
  .la-tr { padding: 24px 26px 14px; }
  .la-list { list-style: none; counter-reset: tr; }
  .la-list li { counter-increment: tr; border-top: 1px solid var(--line); }
  .la-list li:first-child { border-top: 0; }
  .la-list a { display: grid; grid-template-columns: 34px 1fr 24px; gap: 12px; align-items: start; padding: 16px 0; }
  .la-list a::before { content: counter(tr, decimal-leading-zero); font: 700 22px/1 var(--font-display); color: var(--plum-300); padding-top: 2px; transition: color 0.25s; }
  .la-txt { display: grid; gap: 5px; }
  .la-txt time { font-size: 12.5px; color: var(--ink-mute); font-weight: 500; }
  .la-txt strong { font: 600 15.5px/1.35 var(--font-display); letter-spacing: -0.01em; transition: color 0.2s; }
  .la-list :global(.la-go) { color: var(--plum-500); margin-top: 18px; transition: transform 0.3s var(--ease); }
  .la-list a:hover::before { color: var(--sun-500); }
  .la-list a:hover strong { color: var(--plum-700); }
  .la-list a:hover :global(.la-go) { transform: translate(3px, -3px); }

  /* ---------- 2 · browse ---------- */
  .lg { padding: clamp(40px, 6vw, 80px) 0; background: #fff; border-block: 1px solid var(--line); }
  .lg-grid { display: grid; grid-template-columns: 272px minmax(0, 1fr); gap: clamp(24px, 3vw, 44px); align-items: start; }
  .lg-side { position: sticky; top: calc(var(--header-h) + 20px); display: grid; gap: 18px; padding: 20px 18px; border-radius: var(--r-lg); background: var(--cream); border: 1px solid var(--line); max-height: calc(100vh - var(--header-h) - 40px); overflow-y: auto; scrollbar-width: thin; }
  .lg-side-top { display: flex; justify-content: space-between; align-items: center; }
  .lg-reset { padding: 8px 14px; border-radius: var(--r-pill); border: 1px solid var(--line-strong); background: #fff; font-size: 14px; font-weight: 600; color: var(--plum-700); transition: all 0.2s; }
  .lg-reset:hover { background: var(--plum-700); border-color: var(--plum-700); color: #fff; }
  .lg-close { display: none; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line); background: #fff; place-items: center; }
  .lg-group { border: 0; margin: 0; padding: 0; display: grid; gap: 2px; }
  .lg-group legend { padding: 0 0 8px; font: 650 15.5px var(--font-display); letter-spacing: -0.01em; }
  .lg-opt { position: relative; display: grid; grid-template-columns: 38px 1fr 20px; gap: 10px; align-items: center; padding: 4px 8px 4px 4px; border-radius: 12px; cursor: pointer; transition: background 0.2s; }
  .lg-opt:hover { background: #fff; }
  .lg-opt input { position: absolute; opacity: 0; pointer-events: none; }
  .lg-ic { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; background: #fff; border: 1px solid var(--line); transition: all 0.2s; }
  .lg-ic img { width: 28px; height: 28px; object-fit: contain; }
  .lg-lab { font-size: 14.5px; font-weight: 500; color: var(--ink-soft); line-height: 1.25; }
  .lg-box { width: 20px; height: 20px; border-radius: 6px; border: 1.5px solid var(--line-strong); background: #fff; display: grid; place-items: center; color: transparent; transition: all 0.2s; }
  .lg-opt:has(input:checked) { background: #fff; box-shadow: var(--shadow-sm); }
  .lg-opt:has(input:checked) .lg-ic { background: var(--plum-50); border-color: var(--plum-300); }
  .lg-opt:has(input:checked) .lg-lab { color: var(--ink); font-weight: 650; }
  .lg-opt:has(input:checked) .lg-box { background: var(--plum-700); border-color: var(--plum-700); color: #fff; }
  .lg-opt:has(input:focus-visible) { outline: 3px solid var(--sun-500); outline-offset: 1px; }
  .lg-scrim { display: none; }

  .lg-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; justify-content: space-between; margin-bottom: 24px; }
  .lg-types { display: inline-flex; padding: 4px; gap: 2px; border-radius: var(--r-pill); background: var(--cream); border: 1px solid var(--line); }
  .lg-types button { min-height: 40px; padding: 0 20px; border: 0; border-radius: var(--r-pill); background: none; font-size: 15px; font-weight: 600; color: var(--ink-soft); transition: all 0.2s; }
  .lg-types button:hover { color: var(--plum-700); }
  .lg-types button[aria-pressed="true"] { background: var(--plum-700); color: #fff; box-shadow: 0 6px 14px -8px rgba(94, 25, 81, 0.8); }
  .lg-ftoggle { display: none; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: var(--r-pill); border: 1px solid var(--line-strong); background: #fff; font-weight: 600; font-size: 15px; }
  .lg-fcount { min-width: 22px; height: 22px; padding: 0 6px; border-radius: 11px; background: var(--plum-700); color: #fff; font-size: 12.5px; display: inline-grid; place-items: center; }
  .lg-fcount[hidden] { display: none; }
  .lg-search { flex: 0 1 340px; display: flex; align-items: center; gap: 8px; padding: 0 6px 0 16px; min-height: 48px; border-radius: var(--r-pill); border: 1.5px solid var(--line-strong); background: #fff; color: var(--ink-mute); transition: border-color 0.2s, box-shadow 0.2s; }
  .lg-search:focus-within { border-color: var(--plum-500); box-shadow: 0 0 0 4px var(--plum-100); }
  .lg-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font-size: 16px; color: var(--ink); }
  .lg-search input::-webkit-search-cancel-button { display: none; }
  .lg-clear { padding: 6px 12px; border: 0; border-radius: var(--r-pill); background: var(--plum-50); color: var(--plum-700); font-size: 13.5px; font-weight: 600; }

  .lg-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 26px); }
  .lg-empty { padding: 48px 0; text-align: center; color: var(--ink-mute); }
  .lg-more { display: flex; justify-content: center; margin-top: 40px; }
  .lg-more [hidden] { display: none; }

  /* card: image, date, title (what the live cards show) */
  .lc a { height: 100%; display: flex; flex-direction: column; border-radius: var(--r-lg); background: #fff; border: 1px solid var(--line); overflow: hidden; transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease), border-color 0.3s; }
  .lc a:hover { transform: translateY(-5px); box-shadow: 0 26px 50px -30px rgba(36, 12, 44, 0.45); border-color: var(--plum-200); }
  .lc a:focus-visible { outline: 3px solid var(--sun-500); outline-offset: 3px; }
  .lc-img { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: linear-gradient(135deg, var(--plum-100), var(--sun-100)); }
  .lc-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .lc a:hover .lc-img img { transform: scale(1.05); }
  .lc-play { position: absolute; left: 12px; bottom: 12px; width: 38px; height: 38px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--plum-700); box-shadow: var(--shadow-md); }
  .lc-body { display: grid; align-content: start; gap: 8px; padding: 16px 18px 20px; flex: 1; }
  .rail-in .lc-body { flex: none; min-height: 118px; }
  .lc-body time { font-size: 13px; color: var(--ink-mute); font-weight: 500; }
  .lc-body h3 { font-size: 18px; line-height: 1.28; letter-spacing: -0.012em; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .lc :global(mark) { background: var(--sun-200); color: inherit; border-radius: 3px; }

  /* ---------- rails (must knows, expert) ---------- */
  .rail-head { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: clamp(20px, 3vw, 32px); }
  .rail-h { font-size: clamp(28px, 3.6vw, 44px); letter-spacing: -0.03em; }
  .rail-nav { display: flex; gap: 8px; flex: none; }
  .rail-nav button { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-strong); background: #fff; color: var(--plum-700); transition: all 0.2s; }
  .rail-nav button:hover:not(:disabled) { background: var(--plum-700); border-color: var(--plum-700); color: #fff; }
  .rail-nav button:disabled { opacity: 0.35; cursor: default; }
  .rail {
    --pad: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    display: grid; grid-auto-flow: column; grid-auto-columns: clamp(260px, 27vw, 340px); gap: clamp(14px, 1.6vw, 22px);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--pad); padding: 6px var(--pad) 26px; scrollbar-width: none;
  }
  .rail::-webkit-scrollbar { display: none; }
  .rail:focus-visible { outline: 3px solid var(--sun-500); outline-offset: -3px; }
  .rail > * { scroll-snap-align: start; }

  .lm { padding: clamp(56px, 7vw, 96px) 0 clamp(24px, 3vw, 40px); }

  .le { padding: clamp(24px, 3vw, 40px) 0 clamp(40px, 5vw, 64px); }
  .le-panel { padding: clamp(24px, 4vw, 52px); border-radius: var(--r-xl); background: linear-gradient(150deg, var(--plum-100), var(--plum-50) 60%, #fff); border: 1px solid var(--plum-200); overflow: hidden; }
  .le-grid { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(14px, 1.6vw, 22px); align-items: stretch; }
  .le-who { margin: 0; display: flex; flex-direction: column; border-radius: var(--r-lg); overflow: hidden; background: var(--plum-900); color: #fff; box-shadow: var(--shadow-md); }
  .le-who img { width: 100%; aspect-ratio: 4 / 3.4; object-fit: cover; object-position: center 20%; }
  .le-who figcaption { display: grid; gap: 4px; padding: 18px 20px 22px; }
  .le-name { font: 700 22px/1.15 var(--font-display); letter-spacing: -0.02em; }
  .le-role { font-size: 14px; font-weight: 700; color: var(--sun-500); }
  .le-sub { font-size: 14px; color: rgba(255, 255, 255, 0.72); }
  .rail-in { --pad: 0px; grid-auto-columns: clamp(250px, 24vw, 300px); padding: 0 0 6px; margin: 0; }
  /* expert cards stand as tall as the profile card, so the picture takes the extra height */
  .rail-in .lc-img { aspect-ratio: auto; flex: 1; min-height: 150px; }

  /* ---------- 5 · newsletter ---------- */
  .ln { padding: clamp(24px, 3vw, 40px) 0 clamp(56px, 7vw, 96px); }
  .ln-panel { position: relative; isolation: isolate; overflow: hidden; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 64px); align-items: center; padding: clamp(28px, 5vw, 64px); border-radius: var(--r-xl); background: var(--plum-900); color: #fff; }
  .ln-panel::before { content: ""; position: absolute; z-index: -1; width: 520px; height: 520px; right: -140px; top: -220px; border-radius: 50%; background: radial-gradient(circle, rgba(255, 181, 71, 0.28), transparent 65%); }
  .ln-panel::after { content: ""; position: absolute; z-index: -1; width: 420px; height: 420px; left: -160px; bottom: -260px; border-radius: 50%; background: radial-gradient(circle, rgba(155, 74, 140, 0.55), transparent 65%); }
  .ln-h { font-size: clamp(30px, 3.8vw, 48px); letter-spacing: -0.03em; }
  .ln-copy p { margin-top: 14px; max-width: 46ch; color: rgba(255, 255, 255, 0.78); font-size: clamp(16px, 1.3vw, 18px); }
  .ln-act { display: grid; gap: 22px; }
  .ln-form { display: flex; flex-wrap: wrap; gap: 8px; padding: 6px; border-radius: var(--r-pill); background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2); }
  .ln-form:focus-within { border-color: var(--sun-500); }
  .ln-form input[type="email"] { flex: 1; min-width: 0; border: 0; outline: 0; background: none; color: #fff; padding: 0 8px 0 18px; font-size: 16px; min-height: 48px; }
  .ln-form input::placeholder { color: rgba(255, 255, 255, 0.6); }
  .ln-social { list-style: none; display: flex; gap: 10px; }
  .ln-social a { width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: rgba(255, 255, 255, 0.1); color: #fff; transition: all 0.25s; }
  .ln-social a:hover { background: var(--sun-500); color: var(--plum-950); transform: translateY(-2px); }

  /* ---------- responsive ---------- */
  /* short laptop screens (1280×720, 1366×768): keep the whole banner above the fold */
  @media (min-width: 901px) and (max-height: 820px) {
    .lb { padding-top: 14px; }
    .lb-crumbs { margin-bottom: 12px; }
    .la-nl { padding: 20px 22px 18px; }
    .la-h { font-size: 21px; margin-bottom: 10px; }
    .la-tr { padding: 18px 22px 8px; }
    .la-list a { padding: 11px 0; gap: 10px; }
    .la-list a::before { font-size: 19px; }
    .la-txt strong { font-size: 14.5px; }
    .lf { min-height: 400px; }
    .lf-title { font-size: clamp(28px, 3.2vw, 42px); }
  }
  @media (max-width: 1100px) {
    .lb-grid { grid-template-columns: minmax(0, 1fr) 330px; }
    .lg-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 900px) {
    .lb-grid { grid-template-columns: 1fr; }
    .lf { min-height: clamp(380px, 62vh, 520px); }
    .la { grid-template-columns: 1fr 1fr; grid-template-rows: none; }
    .la-nl { border-bottom: 0; border-right: 1px solid var(--line); }
    .lg-grid { grid-template-columns: 1fr; }
    .lg-ftoggle { display: inline-flex; }
    .lg-side { position: fixed; z-index: 60; top: auto; left: 0; right: 0; bottom: 0; max-height: 82vh; border-radius: 24px 24px 0 0; padding: 18px 20px calc(20px + env(safe-area-inset-bottom)); background: var(--cream); box-shadow: var(--shadow-lg); transform: translateY(105%); visibility: hidden; transition: transform 0.4s var(--ease), visibility 0s 0.4s; }
    .lg-side.open { transform: none; visibility: visible; transition: transform 0.4s var(--ease); }
    .lg-close { display: grid; }
    .lg-scrim:not([hidden]) { display: block; position: fixed; inset: 0; z-index: 59; background: rgba(27, 8, 32, 0.45); }
    .le-grid { grid-template-columns: 1fr; }
    .le-who { flex-direction: row; align-items: stretch; }
    .le-who img { width: 40%; max-width: 220px; aspect-ratio: auto; flex: none; object-position: center 25%; }
    .le-who figcaption { align-content: center; }
    .rail-in .lc-img { aspect-ratio: 16 / 9; flex: none; min-height: 0; }
    .ln-panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .la { grid-template-columns: 1fr; }
    .la-nl { border-right: 0; border-bottom: 1px solid var(--line); }
    .lg-bar { display: grid; grid-template-columns: 1fr auto; }
    .lg-types { grid-column: 1 / -1; justify-self: start; }
    .lg-search { flex: none; min-width: 0; }
    /* phones: the grid becomes a compact list, picture on the left */
    .lg-cards { grid-template-columns: 1fr; gap: 12px; }
    .lg-cards .lc a { flex-direction: row; border-radius: 18px; }
    .lg-cards .lc-img { width: 38%; flex: none; aspect-ratio: auto; min-height: 104px; }
    .lg-cards .lc-body { padding: 12px 14px; gap: 6px; align-content: center; }
    .lg-cards .lc-body h3 { font-size: 15.5px; }
    .lg-cards .lc-body time { font-size: 12px; }
    .lg-cards .lc-play { width: 30px; height: 30px; left: 8px; bottom: 8px; }
    .rail-nav { display: none; }
    .rail { grid-auto-columns: 78vw; }
    .rail-in { grid-auto-columns: 78vw; }
    .lf-title { font-size: clamp(26px, 7.4vw, 34px); }
  }
</style>

<script>
  import { media } from "../../lib/site";
  type Row = { s: string; t: string; d: string; e: string; i: string; m: number; v: boolean; c: string[]; w: string[]; h: string[]; o: string[] };

  const MONTHS = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  const fmt = (iso: string) => { const [y, m, d] = iso.slice(0, 10).split("-").map(Number); return `${MONTHS[m - 1]} ${d}, ${y}`; };

  // ---------- browse: filters, type, search, load more ----------
  const cards = document.querySelector<HTMLElement>("[data-cards]")!;
  const more = document.querySelector<HTMLButtonElement>("[data-more]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const status = document.querySelector<HTMLElement>("[data-status]")!;
  const tpl = document.getElementById("lc-tpl") as HTMLTemplateElement;
  const q = document.getElementById("lg-q") as HTMLInputElement;
  const clear = document.querySelector<HTMLButtonElement>("[data-clear]")!;
  const types = document.querySelector<HTMLElement>("[data-types]")!;
  const fcount = document.querySelector<HTMLElement>("[data-fcount]")!;
  const PAGE = cards.children.length || 9;
  const sel: Record<"w" | "h" | "o", Set<string>> = { w: new Set(), h: new Set(), o: new Set() };
  let type = "";
  let shown = PAGE;
  let rows: Row[] = [];
  let touched = false;
  const load = fetch("/posts-index.json").then((r) => r.json()).then((d: Row[]) => (rows = d));

  function card(r: Row) {
    const n = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    n.querySelector("a")!.href = `/learn/${r.s}/`;
    const img = n.querySelector("img")!;
    if (r.i) img.src = media(r.i); else img.remove();
    if (r.v) n.querySelector(".lc-img")!.insertAdjacentHTML("beforeend", `<span class="lc-play"><svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg></span>`);
    const t = n.querySelector("time")!; t.dateTime = r.d; t.textContent = fmt(r.d);
    n.querySelector("h3")!.textContent = r.t;
    return n;
  }
  function filtered() {
    const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    return rows.filter((r) =>
      (!type || r.c.includes(type)) &&
      (["w", "h", "o"] as const).every((k) => !sel[k].size || r[k].some((x) => sel[k].has(x))) &&
      words.every((w) => (r.t + " " + r.e).toLowerCase().includes(w)),
    );
  }
  function syncUrl() {
    const p = new URLSearchParams();
    if (type) p.set("type", type);
    (["w", "h", "o"] as const).forEach((k) => sel[k].size && p.set(k, [...sel[k]].join(",")));
    if (q.value.trim()) p.set("q", q.value.trim());
    history.replaceState(null, "", `${location.pathname}${p.size ? `?${p}` : ""}${location.hash}`);
  }
  async function render(reset = true) {
    touched = true;
    await load;
    if (reset) shown = PAGE;
    const list = filtered();
    cards.replaceChildren(...list.slice(0, shown).map(card));
    empty.hidden = list.length > 0;
    more.hidden = shown >= list.length;
    status.textContent = `${list.length} results`;
    const n = sel.w.size + sel.h.size + sel.o.size;
    fcount.hidden = !n; fcount.textContent = String(n);
    clear.hidden = !q.value;
    syncUrl();
  }

  document.querySelectorAll<HTMLFieldSetElement>("[data-group]").forEach((g) => {
    const key = g.dataset.group as "w" | "h" | "o";
    g.addEventListener("change", (e) => {
      const i = e.target as HTMLInputElement;
      i.checked ? sel[key].add(i.value) : sel[key].delete(i.value);
      render();
    });
  });
  types.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>("button[data-v]");
    if (!b) return;
    type = b.dataset.v!;
    types.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
    render();
  });
  let timer: number | undefined;
  q.addEventListener("input", () => { clear.hidden = !q.value; clearTimeout(timer); timer = window.setTimeout(() => render(), 220); });
  clear.addEventListener("click", () => { q.value = ""; q.focus(); render(); });
  document.querySelector("[data-reset]")!.addEventListener("click", () => {
    Object.values(sel).forEach((s) => s.clear());
    document.querySelectorAll<HTMLInputElement>("[data-group] input").forEach((i) => (i.checked = false));
    type = ""; types.querySelectorAll("button").forEach((x, i) => x.setAttribute("aria-pressed", String(i === 0)));
    q.value = "";
    render();
  });
  more.addEventListener("click", async () => {
    const before = cards.children.length;
    shown += PAGE;
    if (!touched) await load;
    await render(false);
    (cards.children[before]?.querySelector("a") as HTMLElement | null)?.focus({ preventScroll: true });
  });

  // restore filters from the URL (?type=videos&h=back-pain&q=sciatica) so filtered views can be shared
  {
    const p = new URLSearchParams(location.search);
    let any = false;
    (["w", "h", "o"] as const).forEach((k) => p.get(k)?.split(",").forEach((v) => {
      const i = document.querySelector<HTMLInputElement>(`[data-group="${k}"] input[value="${CSS.escape(v)}"]`);
      if (i) { i.checked = true; sel[k].add(v); any = true; }
    }));
    const t = p.get("type");
    const tb = t && types.querySelector<HTMLButtonElement>(`button[data-v="${CSS.escape(t)}"]`);
    if (tb) { type = t!; types.querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String(x === tb))); any = true; }
    if (p.get("q")) { q.value = p.get("q")!; any = true; }
    if (any) render();
  }

  // mobile: filters open as a bottom sheet
  const side = document.getElementById("filters")!;
  const scrim = document.querySelector<HTMLElement>(".lg-scrim")!;
  const opener = document.querySelector<HTMLButtonElement>("[data-filters-open]")!;
  const setOpen = (on: boolean) => {
    side.classList.toggle("open", on); scrim.hidden = !on; opener.setAttribute("aria-expanded", String(on));
    document.documentElement.style.overflow = on ? "hidden" : "";
    if (on) side.querySelector<HTMLElement>("input, button")?.focus(); else opener.focus({ preventScroll: true });
  };
  opener.addEventListener("click", () => setOpen(true));
  document.querySelectorAll("[data-filters-close]").forEach((b) => b.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && side.classList.contains("open")) setOpen(false); });

  // ---------- rails: prev/next scroll by a page of cards ----------
  document.querySelectorAll<HTMLElement>(".rail[id]").forEach((rail) => {
    const prev = document.querySelector<HTMLButtonElement>(`[data-prev="${rail.id}"]`);
    const next = document.querySelector<HTMLButtonElement>(`[data-next="${rail.id}"]`);
    const step = () => {
      const c = rail.firstElementChild as HTMLElement;
      const w = c.offsetWidth + (parseFloat(getComputedStyle(rail).columnGap) || 0);
      return Math.max(1, Math.floor(rail.clientWidth / w)) * w;
    };
    const update = () => {
      if (prev) prev.disabled = rail.scrollLeft <= 4;
      if (next) next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 4;
    };
    prev?.addEventListener("click", () => rail.scrollBy({ left: -step(), behavior: "smooth" }));
    next?.addEventListener("click", () => rail.scrollBy({ left: step(), behavior: "smooth" }));
    rail.addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
    update();
  });
</script>

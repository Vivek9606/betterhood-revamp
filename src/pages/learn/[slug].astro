---
// Article template — every post at /learn/{slug}/. Same sections, copy and links as the live article page
// (see REVAMP-GUIDELINES.md). Copy around the body comes from src/data/article.json (npm run scrape:article);
// the body is the WordPress HTML, untouched except for structure added in src/lib/article.ts.
//   breadcrumb · title · "by {author} | {date} | {category}" · featured image (or the video) · body
//   sidebar: Subscribe to Newsletter, What's Trending (4 newest, not this one), social links
//   Featured Articles (3 newest sharing the health concern) · Featured Products (Shopify, fixed list)
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import A from "../../data/article.json";
import AUTHORS from "../../data/authors.json";
import { posts, products, termName, isVideo, type Post } from "../../lib/data";
import { processArticle } from "../../lib/article";
import { media } from "../../lib/site";
import Betty from "../../components/Betty.astro";
import BETTY from "../../data/betty.json";
import { productFromHref, productPhrases } from "../../lib/betty";

// "In this article" is the one visible element the live page doesn't have: a list of the article's own H2s.
// Pending team sign-off (REVAMP-GUIDELINES.md); set to false to remove it everywhere.
const SHOW_TOC = true;

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props as { post: Post };
type Part = { t: string; light?: boolean; sup?: boolean };

// Betty (src/components/Betty.astro) is a new feature beyond the like-for-like revamp: switch it off in betty.json
const { html, toc, faq, citations, words, mentions } = processArticle(post.html, {
  mentions: BETTY.enabled ? { fromHref: productFromHref, phrases: productPhrases(), max: BETTY.maxSurprisesPerArticle } : undefined,
});
const video = isVideo(post);
// the live page shows a video post's first video above the body; any video already embedded in the body
// stays where it is, so it's never shown twice
const inBody = (id: string) => post.html.includes(id);
const topVideo = video ? post.videos.find((v) => !inBody(v)) : undefined;
const moreVideos = video ? post.videos.filter((v) => v !== topVideo && !inBody(v)) : [];
const site = "https://betterhood.in";
const url = `${site}/learn/${post.slug}/`;
const author = (AUTHORS as Record<string, { slug: string; name: string }>)[post.author] ?? { slug: "", name: post.author };
const authorUrl = author.slug ? `/learn/author/${author.slug}/` : "";
const category = post.category.find((c) => c !== "uncategorized") ?? post.category[0];

const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
// live byline/trending format: "Sep 16, 2026" (date part only, so the build machine's time zone can't shift it)
const fmt = (iso: string) => { const [y, m, d] = iso.slice(0, 10).split("-").map(Number); return `${MONTHS[m - 1]} ${d}, ${y}`; };
// WordPress stores IST wall-clock times; publish them with their offset
const ist = (iso: string) => (iso && !/[zZ]|[+-]\d\d:\d\d$/.test(iso) ? `${iso}+05:30` : iso);
const thumb = (p: Post) => p.image?.thumb || p.image?.src || (p.videos[0] ? `https://i.ytimg.com/vi/${p.videos[0]}/hqdefault.jpg` : "");

const trending = posts.filter((p) => p.slug !== post.slug).slice(0, A.trending.count);
const featured = post.concern[0]
  ? posts.filter((p) => p.slug !== post.slug && p.concern.some((c) => post.concern.includes(c))).slice(0, A.featuredArticles.count)
  : [];
const picks = A.featuredProducts.handles.map((h) => products.find((p) => p.handle === h)).filter(Boolean) as typeof products;
const rupee = (n: number) => `₹${n.toFixed(2)}`;
const shopImg = (u: string, w = 500) => (u.includes("cdn.shopify.com") ? `${u}${u.includes("?") ? "&" : "?"}width=${w}` : u);
const socialIcon = (href: string) => (/linkedin/.test(href) ? "linkedin" : /instagram/.test(href) ? "instagram" : /youtube/.test(href) ? "youtube" : "facebook");
const socialName = (href: string) => ({ linkedin: "LinkedIn", instagram: "Instagram", youtube: "YouTube", facebook: "Facebook" })[socialIcon(href)];

// ---------- structured data ----------
const pageId = `${url}#webpage`;
const org = { "@id": `${site}/#organization` };
const authorLd = post.author === "betterhood"
  ? org
  : { "@type": "Person", "@id": `${site}/#/person/${author.slug || encodeURIComponent(post.author)}`, name: author.name, ...(authorUrl && { url: `${site}${authorUrl}` }), worksFor: org };
const conditions = post.concern.map((c) => ({ "@type": "MedicalCondition", name: termName("by-health-concern", c) }));
const image = post.image ? { "@type": "ImageObject", url: new URL(media(post.image.src), site).href, width: post.image.w, height: post.image.h, caption: post.image.alt || undefined } : undefined;
const keywords = [
  ...post.concern.map((s) => termName("by-health-concern", s)),
  ...post.solution.map((s) => termName("by-solution", s)),
  ...post.inside.map((s) => termName("by-what-inside", s)),
];
const graph: Record<string, unknown>[] = [
  {
    "@type": conditions.length ? ["WebPage", "MedicalWebPage"] : "WebPage",
    "@id": pageId,
    url,
    name: post.seo.title || post.title,
    description: post.seo.description,
    inLanguage: "en-IN",
    isPartOf: { "@type": "WebSite", "@id": `${site}/#website`, url: `${site}/`, name: "betterhood" },
    breadcrumb: { "@id": `${url}#breadcrumb` },
    ...(image && { primaryImageOfPage: image }),
    ...(conditions.length && { about: conditions }),
    datePublished: ist(post.date),
    dateModified: ist(post.modified),
  },
  video && post.videos[0]
    ? {
        "@type": "VideoObject",
        "@id": `${url}#video`,
        name: post.title,
        description: post.seo.description || post.excerpt || post.title,
        uploadDate: ist(post.date),
        thumbnailUrl: `https://i.ytimg.com/vi/${post.videos[0]}/hqdefault.jpg`,
        embedUrl: `https://www.youtube.com/embed/${post.videos[0]}`,
        contentUrl: `https://www.youtube.com/watch?v=${post.videos[0]}`,
        publisher: org,
        isPartOf: { "@id": pageId },
      }
    : {
        "@type": "BlogPosting",
        "@id": `${url}#article`,
        headline: post.title,
        description: post.seo.description,
        mainEntityOfPage: { "@id": pageId },
        ...(image && { image }),
        author: authorLd,
        publisher: org,
        datePublished: ist(post.date),
        dateModified: ist(post.modified),
        wordCount: words,
        timeRequired: `PT${post.minutes || Math.max(1, Math.round(words / 230))}M`,
        articleSection: termName("category", category),
        ...(keywords.length && { keywords: keywords.join(", ") }),
        ...(conditions.length && { about: conditions }),
        inLanguage: "en-IN",
        ...(citations.length && { citation: citations.map((c) => ({ "@type": "CreativeWork", name: c.name, ...(c.url && { url: c.url }) })) }),
      },
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: A.breadcrumb[0], item: `${site}/` },
      { "@type": "ListItem", position: 2, name: A.breadcrumb[1], item: `${site}/learn/` },
      { "@type": "ListItem", position: 3, name: post.title, item: url },
    ],
  },
];
if (faq.length) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    isPartOf: { "@id": pageId },
    mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
  });
}
const jsonLd = { "@context": "https://schema.org", "@graph": graph };
const heading = (parts: Part[]) => parts;
---
<Base
  title={post.seo.title || post.title}
  description={post.seo.description}
  image={post.image?.src ?? (post.videos[0] ? `https://i.ytimg.com/vi/${post.videos[0]}/hqdefault.jpg` : undefined)}
  imageAlt={post.image?.alt || post.title}
  imageWidth={post.image?.w}
  imageHeight={post.image?.h}
  type="article"
  published={ist(post.date)}
  modified={ist(post.modified)}
  jsonLd={jsonLd}
>
  <div class="a-progress" aria-hidden="true"><span data-progress></span></div>

  <div class="a-band">
    <div class="wrap a-grid">
      <article class="a-main" data-article>
        <header class="a-head">
          <nav class="breadcrumbs a-crumbs" aria-label="Breadcrumb">
            <a href="/">{A.breadcrumb[0]}</a><span aria-hidden="true">›</span><a href="/learn/">{A.breadcrumb[1]}</a><span aria-hidden="true">›</span><span aria-current="page">{post.title}</span>
          </nav>
          <h1 class="a-title">{post.title}</h1>
          <p class="a-meta">
            <span class="a-av" aria-hidden="true">{author.name.trim()[0]?.toUpperCase()}</span>
            <span>{A.meta.by} {authorUrl ? <a href={authorUrl} rel="author">{author.name}</a> : author.name}</span>
            <span class="a-sep" aria-hidden="true">{A.meta.separator}</span>
            <time datetime={post.date.slice(0, 10)}>{fmt(post.date)}</time>
            {category && <><span class="a-sep" aria-hidden="true">{A.meta.separator}</span><a href={`/learn/category/${category}/`} rel="tag">{termName("category", category)}</a></>}
          </p>
        </header>

        {topVideo ? (
          <div class="a-video"><iframe src={`https://www.youtube-nocookie.com/embed/${topVideo}?rel=0`} title={post.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>
        ) : !video && post.image && (
          <figure class="a-hero">
            <img src={media(post.image.src)} alt={post.image.alt} width={post.image.w || 1200} height={post.image.h || 675} fetchpriority="high" decoding="async" />
          </figure>
        )}

        {SHOW_TOC && toc.length > 2 && (
          <details class="a-toc-m">
            <summary><Icon name="menu" size={18} /> In this article <Icon name="chevron" size={18} class="a-chev" /></summary>
            <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
          </details>
        )}

        {html.trim() && <div class="prose a-prose" set:html={html} />}
        {moreVideos.map((v) => (
          <div class="a-video sm"><iframe src={`https://www.youtube-nocookie.com/embed/${v}?rel=0`} title={post.title} loading="lazy" allowfullscreen></iframe></div>
        ))}
      </article>

      <aside class="a-side" aria-label="Newsletter and trending">
        <div class="s-card">
          <div class="s-nl">
            <h2 class="s-h">{heading(A.newsletter.heading as Part[]).map((p) => (p.light ? <span class="lt">{p.t}</span> : p.t))}</h2>
            <form class="s-form" data-bh-form="newsletter">
              <label class="sr-only" for="nl-side">{A.newsletter.placeholder}</label>
              <input id="nl-side" type="email" name="email" placeholder={A.newsletter.placeholder} required autocomplete="email" />
              <input type="text" name="website" tabindex="-1" autocomplete="off" class="sr-only" aria-hidden="true" />
              <button class="btn btn-sm" type="submit">{A.newsletter.submit}</button>
              <p data-note hidden></p>
            </form>
          </div>
          <div class="s-tr">
            <h2 class="s-h">{heading(A.trending.heading as Part[]).map((p) => (p.light ? <span class="lt">{p.t}</span> : p.t))}</h2>
            <ol class="s-list">
              {trending.map((p) => (
                <li><a href={`/learn/${p.slug}/`}><span><time datetime={p.date.slice(0, 10)}>{fmt(p.date)}</time><strong>{p.title}</strong></span><Icon name="arrow-up-right" size={18} class="s-go" /></a></li>
              ))}
            </ol>
          </div>
          <ul class="s-social">
            {A.socials.map((s) => <li><a href={s} target="_blank" rel="noopener" aria-label={`betterhood on ${socialName(s)}`}><Icon name={socialIcon(s)} size={18} /></a></li>)}
          </ul>
        </div>

        {SHOW_TOC && toc.length > 2 && (
          <nav class="a-toc" aria-label="In this article">
            <p class="a-toc-t">In this article</p>
            <ol>{toc.map((t) => <li><a href={`#${t.id}`}>{t.text}</a></li>)}</ol>
          </nav>
        )}
      </aside>
    </div>
  </div>

  {featured.length > 0 && (
    <section class="fa" aria-labelledby="fa-h">
      <div class="wrap">
        <h2 class="x-h" id="fa-h">{heading(A.featuredArticles.heading as Part[]).map((p) => (p.light ? <span class="lt">{p.t}</span> : p.t))}</h2>
        <div class="fa-grid">
          {featured.map((p) => (
            <article class="fa-card">
              <a href={`/learn/${p.slug}/`}>
                <span class="fa-img">{thumb(p) && <img src={media(thumb(p))} alt={p.image?.alt ?? ""} width="768" height="432" loading="lazy" decoding="async" />}</span>
                <h3>{p.title}</h3>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="fp" aria-labelledby="fp-h">
    <div class="wrap">
      <div class="fp-head">
        <div>
          <h2 class="x-h" id="fp-h">{heading(A.featuredProducts.heading as Part[]).map((p) => (p.light ? <span class="lt">{p.t}</span> : p.t))}</h2>
          <p class="fp-offer">{A.featuredProducts.offer.map((p) => ("bold" in p && p.bold ? <strong>{p.t}</strong> : p.t))}</p>
        </div>
        <div class="fp-nav"><button type="button" data-prev aria-label="Previous" disabled><Icon name="arrow-left" size={20} /></button><button type="button" data-next aria-label="Next"><Icon name="arrow" size={20} /></button></div>
      </div>
    </div>
    <div class="fp-rail" data-rail tabindex="0" aria-label={(A.featuredProducts.heading as Part[]).map((p) => p.t).join("")}>
      {picks.map((p) => (
        <article class="pd">
          <a class="pd-link" href={`https://shop.betterhood.in/products/${p.handle}`}>
            <span class="pd-img"><img src={shopImg(p.image)} alt={p.title} width="400" height="400" loading="lazy" decoding="async" /></span>
            <h3>{p.title}</h3>
            <p class="pd-price">{p.compare > p.price && <s>{rupee(p.compare)}</s>}<span>{rupee(p.price)}</span></p>
          </a>
          <a class="btn btn-sm pd-btn" href={`https://shop.betterhood.in/products/${p.handle}`} tabindex="-1" aria-hidden="true">{A.featuredProducts.cta}</a>
        </article>
      ))}
    </div>
  </section>
  {BETTY.enabled && (
    <Betty products={mentions.map((h) => products.find((p) => p.handle === h)!).filter(Boolean)} slug={post.slug} offer={A.featuredProducts.offer} cta={A.featuredProducts.cta} />
  )}
</Base>

<style>
  .lt { font-weight: 300; }
  .a-progress { position: fixed; z-index: 100; top: 0; left: 0; right: 0; height: 3px; pointer-events: none; }
  .a-progress span { display: block; height: 100%; width: 100%; transform-origin: 0 50%; transform: scaleX(var(--p, 0)); background: linear-gradient(90deg, var(--plum-600), var(--sun-500)); }

  .a-band { background: linear-gradient(180deg, var(--plum-50), var(--cream) 520px); padding: clamp(16px, 2.6vw, 30px) 0 clamp(48px, 6vw, 88px); }
  .a-grid { display: grid; grid-template-columns: minmax(0, 760px) 340px; gap: clamp(32px, 4.4vw, 64px); justify-content: center; align-items: start; }

  /* ---------- head ---------- */
  .a-crumbs { margin-bottom: 18px; flex-wrap: nowrap; min-width: 0; }
  .a-crumbs > * { flex: none; }
  .a-crumbs > span[aria-current] { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--ink-soft); }
  .a-title { font-size: clamp(32px, 4.3vw, 54px); line-height: 1.06; letter-spacing: -0.032em; text-wrap: balance; }
  .a-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin-top: 18px; font-size: 15px; color: var(--ink-soft); }
  .a-meta a { color: var(--plum-700); font-weight: 650; }
  .a-meta a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .a-av { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--plum-700); color: #fff; font: 700 14px var(--font-display); margin-right: 2px; }
  .a-sep { color: var(--line-strong); }
  .a-hero { margin: clamp(22px, 3vw, 32px) 0 0; border-radius: var(--r-xl); overflow: hidden; background: var(--plum-100); box-shadow: 0 30px 60px -40px rgba(36, 12, 44, 0.5); }
  .a-hero img { width: 100%; height: auto; max-height: 560px; object-fit: cover; }
  .a-video { margin-top: clamp(22px, 3vw, 32px); aspect-ratio: 16 / 9; border-radius: var(--r-xl); overflow: hidden; background: #000; }
  .a-video iframe { width: 100%; height: 100%; border: 0; }
  .a-video.sm { border-radius: var(--r-md); margin-top: 24px; }

  /* ---------- body ---------- */
  .a-prose { margin-top: clamp(28px, 4vw, 44px); font-size: 18.5px; line-height: 1.78; }
  .a-prose :global(> p:first-child) { font-size: 1.1em; color: var(--ink); }
  .a-prose :global(h2) { position: relative; padding-top: 0.9em; margin-top: 2em; font-size: clamp(25px, 2.6vw, 33px); letter-spacing: -0.025em; }
  .a-prose :global(h2::before) { content: ""; position: absolute; top: 0; left: 0; width: 44px; height: 4px; border-radius: 4px; background: var(--sun-500); }
  .a-prose :global(h3) { color: var(--plum-800); }
  .a-prose :global(h2[id]), .a-prose :global(h3[id]) { scroll-margin-top: calc(var(--header-h) + 24px); }
  .a-prose :global(img) { border-radius: var(--r-lg); }
  .a-prose :global(figure.wp-block-image), .a-prose :global(p > img:only-child) { margin-block: 1.8em; }
  .a-prose :global(ul li::marker) { content: "● "; font-size: 0.7em; }
  .a-prose :global(blockquote) { border-left: 4px solid var(--plum-300); background: var(--plum-50); padding: 18px 22px; border-radius: 0 var(--r-md) var(--r-md) 0; font-style: normal; }
  .a-prose :global(a) { overflow-wrap: anywhere; }

  /* FAQ: the article's own questions and answers, set as a card */
  .a-prose :global(.a-faq) { margin-top: 1em; padding: clamp(18px, 2.6vw, 30px); border-radius: var(--r-lg); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-sm); }
  .a-prose :global(.a-faq > * + *) { margin-top: 0.7em; }
  .a-prose :global(.a-faq .a-q) { display: block; position: relative; padding-left: 40px; margin-top: 1.5em; font: 650 clamp(18px, 1.7vw, 20px)/1.35 var(--font-display); letter-spacing: -0.015em; color: var(--ink); }
  .a-prose :global(.a-faq > :first-child .a-q), .a-prose :global(.a-faq > .a-q:first-child) { margin-top: 0; }
  .a-prose :global(.a-faq .a-q::before) { content: "Q"; position: absolute; left: 0; top: -1px; width: 28px; height: 28px; border-radius: 9px; display: grid; place-items: center; background: var(--plum-700); color: #fff; font: 700 14px/28px var(--font-display); text-align: center; }
  .a-prose :global(.a-faq h2.a-q::before), .a-prose :global(.a-faq h3.a-q::before), .a-prose :global(.a-faq h4.a-q::before) { top: 0; }
  .a-prose :global(.a-faq .a-q + p), .a-prose :global(.a-faq p) { padding-left: 40px; color: var(--ink-soft); }
  /* question and answer in one paragraph: hang the question back over the badge column */
  .a-prose :global(.a-faq p > .a-q:first-child) { margin-left: -40px; margin-bottom: 4px; }
  .a-prose :global(.a-faq h2.a-q), .a-prose :global(.a-faq h3.a-q), .a-prose :global(.a-faq h4.a-q) { padding-top: 0; }
  .a-prose :global(.a-faq h2.a-q::after) { display: none; }
  .a-prose :global(.a-faq h2::before) { width: 28px; height: 28px; }

  /* References: smaller, numbered, every link visible */
  .a-prose :global(.a-refs) { margin-top: 0.8em; padding: 18px 22px; border-radius: var(--r-md); background: var(--plum-50); font-size: 14.5px; line-height: 1.6; color: var(--ink-soft); }
  .a-prose :global(.a-refs ol), .a-prose :global(.a-refs ul) { padding-left: 1.4em; }
  .a-prose :global(.a-refs li + li) { margin-top: 0.6em; }
  .a-prose :global(.a-refs a) { word-break: break-word; }
  .a-prose :global(.a-refs-h) { font-size: 22px !important; }

  /* ---------- sidebar ---------- */
  .a-side { display: grid; gap: 24px; align-self: stretch; align-content: start; }
  .s-card { border-radius: var(--r-xl); background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow-md); overflow: hidden; }
  .s-nl { padding: 24px 24px 22px; background: linear-gradient(160deg, var(--plum-50), #fff); border-bottom: 1px solid var(--line); }
  .s-h { font-size: 22px; letter-spacing: -0.02em; margin-bottom: 12px; }
  .s-form { display: flex; flex-wrap: wrap; gap: 6px; padding: 5px; border-radius: var(--r-pill); background: #fff; border: 1.5px solid var(--line-strong); transition: border-color 0.2s, box-shadow 0.2s; }
  .s-form:focus-within { border-color: var(--plum-500); box-shadow: 0 0 0 4px var(--plum-100); }
  .s-form input[type="email"] { flex: 1; min-width: 0; border: 0; outline: 0; background: none; padding: 0 6px 0 14px; font-size: 15px; min-height: 38px; }
  .s-form [data-note] { flex-basis: 100%; padding: 4px 12px 2px; font-size: 13.5px; }
  .s-tr { padding: 22px 24px 8px; }
  .s-list { list-style: none; }
  .s-list li + li { border-top: 1px solid var(--line); }
  .s-list a { display: grid; grid-template-columns: 1fr 20px; gap: 12px; align-items: start; padding: 14px 0; }
  .s-list span { display: grid; gap: 4px; }
  .s-list time { font-size: 12.5px; color: var(--ink-mute); }
  .s-list strong { font: 600 15px/1.35 var(--font-display); letter-spacing: -0.01em; transition: color 0.2s; }
  .s-list :global(.s-go) { color: var(--plum-500); margin-top: 16px; transition: transform 0.3s var(--ease); }
  .s-list a:hover strong { color: var(--plum-700); }
  .s-list a:hover :global(.s-go) { transform: translate(3px, -3px); }
  .s-social { list-style: none; display: flex; gap: 8px; padding: 14px 24px 20px; border-top: 1px solid var(--line); }

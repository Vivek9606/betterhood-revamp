  .a-toc { position: sticky; top: calc(var(--header-h) + 24px); padding: 20px 20px 16px; border-radius: var(--r-lg); background: rgba(255, 255, 255, 0.7); border: 1px solid var(--line); backdrop-filter: blur(8px); }

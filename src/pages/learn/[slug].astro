  .a-toc ol { list-style: none; display: grid; gap: 1px; max-height: calc(100vh - var(--header-h) - 130px); overflow-y: auto; border-left: 2px solid var(--line); scrollbar-width: thin; }
  .a-toc a { display: block; padding: 6px 0 6px 14px; margin-left: -2px; border-left: 2px solid transparent; font-size: 14px; line-height: 1.4; color: var(--ink-soft); transition: color 0.2s, border-color 0.2s; }
  .a-toc a:hover, .a-toc a.on { color: var(--plum-700); border-color: var(--plum-700); }

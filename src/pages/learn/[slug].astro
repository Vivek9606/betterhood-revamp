  /* ---------- featured articles ---------- */
  .x-h { font-size: clamp(28px, 3.4vw, 42px); letter-spacing: -0.03em; }
  .fa { padding: clamp(48px, 6vw, 88px) 0 clamp(24px, 3vw, 40px); background: #fff; border-top: 1px solid var(--line); }
  .fa-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(16px, 2vw, 26px); margin-top: clamp(20px, 3vw, 32px); }
  .fa-card a { display: flex; flex-direction: column; height: 100%; border-radius: var(--r-lg); overflow: hidden; background: var(--cream); border: 1px solid var(--line); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .fa-card a:hover { transform: translateY(-5px); box-shadow: 0 26px 50px -30px rgba(36, 12, 44, 0.45); }
  .fa-img { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--plum-100); }
  .fa-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .fa-card a:hover .fa-img img { transform: scale(1.05); }
  .fa-card h3 { padding: 16px 18px 20px; font-size: 18px; line-height: 1.3; letter-spacing: -0.012em; }

  /* ---------- featured products ---------- */
  .fp { padding: clamp(40px, 5vw, 72px) 0 clamp(56px, 7vw, 96px); background: #fff; }
  .fp-head { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: clamp(20px, 3vw, 30px); }
  .fp-offer { margin-top: 8px; color: var(--ink-soft); font-size: 16px; }
  .fp-offer strong { color: var(--plum-700); padding: 2px 8px; border-radius: 6px; background: var(--sun-100); border: 1px dashed var(--sun-500); font-weight: 700; letter-spacing: 0.02em; }
  .fp-nav { display: flex; gap: 8px; }
  .fp-nav button { width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--line-strong); background: #fff; color: var(--plum-700); transition: all 0.2s; }
  .fp-nav button:hover:not(:disabled) { background: var(--plum-700); border-color: var(--plum-700); color: #fff; }
  .fp-nav button:disabled { opacity: 0.35; cursor: default; }
  .fp-rail {
    --pad: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
    display: grid; grid-auto-flow: column; grid-auto-columns: clamp(230px, 22vw, 280px); gap: clamp(14px, 1.6vw, 20px);
    overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--pad); padding: 6px var(--pad) 22px; scrollbar-width: none;
  }
  .fp-rail::-webkit-scrollbar { display: none; }
  .fp-rail:focus-visible { outline: 3px solid var(--sun-500); outline-offset: -3px; }
  .pd { scroll-snap-align: start; display: flex; flex-direction: column; border-radius: var(--r-lg); background: var(--cream); border: 1px solid var(--line); overflow: hidden; transition: box-shadow 0.4s var(--ease), transform 0.4s var(--ease); }
  .pd:hover { transform: translateY(-4px); box-shadow: 0 26px 50px -30px rgba(36, 12, 44, 0.45); }

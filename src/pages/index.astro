---
// Homepage. Every word, product, image and link comes from the live betterhood.in homepage via
// src/data/home.json (refresh it with `node scripts/scrape-home.mjs`), in the same section order:
// hero + trust (the live product range strip is left out, by request), shop by concern, co-created story, use cases, clinically accountable +
// physios, categories, testimonials, "most people wait too long", press, sticky assessment CTA.
import Base from "../layouts/Base.astro";
import Hero from "../components/story/Hero.tsx";
import Concern from "../components/story/Concern.tsx";
import Story from "../components/story/Story.tsx";
import UseCases from "../components/story/UseCases.tsx";
import Physios from "../components/story/Physios.tsx";
import Categories from "../components/story/Categories.tsx";
import Proof from "../components/story/Proof.tsx";
import Decades from "../components/story/Decades.tsx";
import Finale from "../components/story/Finale.tsx";
import "../styles/story.css";
import home from "../data/home.json";
import { media } from "../lib/site";
import { plain } from "../lib/rich";

const { hero, trust, concern, story, usecase, clinic, physios, categories, words, age, press, sticky } = home;
const dims = home.dims as Record<string, number[]>;
const m = (src: string) => media(src);
const size = (src: string) => dims[src];

// alt text: the words printed on each category banner
const bannerAlt: Record<string, string> = {
  "pain-relief-recovery": "Pain relief and Recovery: pain relief crafted for recovery",
  orthotics: "Orthotic Support: support designed for movement",
  "chair-cushions": "Posture Support: ergonomics engineered for better posture",
};
const catItems = categories.items.map((c) => ({
  href: c.href,
  image: m(c.image), imageMobile: m(c.imageMobile), size: size(c.image), sizeMobile: size(c.imageMobile),
  alt: bannerAlt[c.href.split("/").pop()!] ?? "Shop the betterhood range",
}));

const site = "https://betterhood.in/";
const title = "Physio Trusted Pain Care for Everyday Movement | betterhood";
const description = "Physio co-created supports and pain relief for back, neck, knee and shoulder pain. Loved by 40K+ customers, rated 4.6★. Take a free pain assessment.";
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${site}#website`,
    url: site,
    name: "betterhood",
    alternateName: ["betterhood India", "betterhood.in"],
    description: "Live better. Live pain-free",
    inLanguage: "en-IN",
    publisher: { "@id": `${site}#organization` },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${site}#webpage`,
    url: site,
    name: title,
    description,
    inLanguage: "en-IN",
    isPartOf: { "@id": `${site}#website` },
    about: { "@id": `${site}#organization` },
    primaryImageOfPage: { "@type": "ImageObject", url: `${site}img/og-home.jpg`, width: 1200, height: 630 },
  },
];
---
<Base title={title} description={description} image="/img/og-home.jpg" imageAlt="betterhood: physio trusted pain care for everyday movement" imageWidth={1200} imageHeight={630} jsonLd={jsonLd}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={m(hero.imageMobile)} media="(max-width: 781px)" fetchpriority="high" />
    <link rel="preload" as="image" href={m(hero.image)} media="(min-width: 782px)" fetchpriority="high" />
    <link rel="preconnect" href="https://cdn.shopify.com" />
    <link rel="dns-prefetch" href="https://i.ytimg.com" />
  </Fragment>

  <!-- hero + trustbar share the first screen, so the trustbar is never cut off -->
  <div class="st-fold">
  <Hero client:load title={hero.title} sub={hero.sub} cta={hero.cta} image={m(hero.image)} imageMobile={m(hero.imageMobile)} size={size(hero.image)} sizeMobile={size(hero.imageMobile)} />

  <section class="st-trustbar" aria-label="Why people trust betterhood">
    <ul class="wrap st-trustbar-in">
      {trust.map((t) => (
        <li><strong>{t.value}{t.label === "Average Rating" && <span aria-hidden="true">★</span>}</strong><span>{t.label}</span></li>
      ))}
    </ul>
  </section>
  </div>

  <Concern client:visible eyebrow={concern.eyebrow} more={concern.more} title={concern.title} sub={concern.sub} tabs={concern.tabs.map((t) => ({ ...t, banner: m(t.banner) }))} bannerSize={size(concern.tabs[0].banner)} />

  <Story client:visible title={story.title} cards={story.cards.map((c) => ({ ...c, pin: m(c.pin) }))} background={{ desktop: m(story.background.desktop), mobile: m(story.background.mobile) }} art={story.art.map(m)} sizes={Object.fromEntries([story.background.desktop, ...story.art].filter((u) => size(u)).map((u) => [m(u), size(u)]))} />

  <UseCases client:visible eyebrow={usecase.eyebrow} more={usecase.more} title={usecase.title} sub={usecase.sub} items={usecase.items.map((u) => ({ ...u, image: m(u.image) }))} size={size(usecase.items[0].image)} />

  <Physios client:visible clinic={{ ...clinic, steps: clinic.steps.map((s) => ({ ...s, icon: m(s.icon) })) }} physios={{ ...physios, people: physios.people.map((p) => ({ ...p, image: m(p.image) })) }} />

  <Categories client:visible title={categories.title} sub={categories.sub} video={categories.video} items={catItems} viewAll={categories.viewAll} />

  <Proof client:visible title={words.title} sub={words.sub} reels={words.reels} />

  <Decades client:visible title={age.title} sub={age.sub} intro={age.intro} decades={age.decades} />
  <Finale client:visible title={age.outro.title} text={age.outro.text} cta={age.outro.cta} />

  <section class="st-pressbar" aria-label="Featured in">
    <h2 class="sr-only">Featured in</h2>
    <div class="st-marquee">
      <div class="st-marquee-track" style="animation-duration: 70s">
        {[0, 1].map((copy) => (
          <ul class="st-marquee-group" aria-hidden={copy ? "true" : undefined}>
            {press.map((p) => (
              <li>
                <a href={p.href} target="_blank" rel="noopener noreferrer" tabindex={copy ? -1 : undefined} aria-label={copy ? undefined : `${p.name} (opens in a new tab)`}>
                  <img src={m(p.logo)} alt={copy ? "" : p.name} width={size(p.logo)?.[0]} height={size(p.logo)?.[1]} loading="lazy" decoding="async" />
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <a class="st-sticky" id="st-sticky" href={sticky.href} aria-label={plain(sticky.label).replace(/\s*→$/, "")}>{sticky.label}</a>
</Base>

<script>
  // The sticky "Get Free Assessment" pill shows once the hero has scrolled away and steps aside
  // where the page already offers the same action (the assessment section) and at the footer.
  const pill = document.getElementById("st-sticky");
  const hero = document.querySelector(".st-hero");
  if (pill && hero && "IntersectionObserver" in window) {
    const hide = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? hide.add(e.target) : hide.delete(e.target);
      pill.classList.toggle("on", hide.size === 0);
    });
    [hero, document.querySelector(".st-finale"), document.querySelector("footer")].forEach((el) => el && io.observe(el));
  }
</script>

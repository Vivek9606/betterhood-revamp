---
// Runs one of the old Gravity Forms assessments with a modern, one-step-at-a-time UI.
// Scoring is identical to the old site (see scripts/quiz-engine.ts). Results are kept on the
// visitor's device (localStorage) for the result pages and betterYou corner.
import Icon from "./Icon.astro";
import { mediaHtml } from "../lib/site";
import { bySlug, cornerSlugs } from "../lib/assessments";

interface Props { slug: string }
const { slug } = Astro.props;
const a = bySlug(slug);
const forms = import.meta.glob("../data/forms/*.json", { eager: true, import: "default" }) as Record<string, any>;
const form = forms[`../data/forms/${slug}.json`];
// absolute media URLs inside the HTML snippets
const prepared = { ...form, fields: form.fields.map((f: any) => ({ ...f, html: f.html ? mediaHtml(f.html) : f.html, default: f.default ? mediaHtml(f.default) : f.default })) };
const config = { ...a, corner: `/${cornerSlugs[a.area]}/` };
const steps = Math.max(...form.fields.map((f: any) => f.page));
---
<section class="qz" data-quiz>
  <div class="wrap qz-wrap">
    <div class="qz-top">
      <a class="qz-back-link" href="/quiz-landing-page/" data-embed-hide><Icon name="arrow-left" size={18} /> <span><span class="lbl-long">All </span>assessments</span></a>
      <button type="button" class="qz-jump" data-jump hidden>How to test <span aria-hidden="true">↓</span></button>
      <p class="qz-step muted" aria-live="polite">Step <span data-step>1</span> of <span data-steps>{steps}</span></p>
    </div>
    <div class="qz-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span data-bar></span></div>

    <form class="qz-card" data-form novalidate>
      <div class="qz-main" data-main>
        <noscript><p class="empty">This assessment needs JavaScript to run. Please enable it, or <a class="link" href="/contact-us/">contact us</a> for help.</p></noscript>
      </div>
      <div class="qz-nav">
        <button type="button" class="btn btn-ghost" data-prev hidden><Icon name="arrow-left" /> Previous</button>
        <button type="submit" class="btn btn-lg" data-next>Start Assessment</button>
      </div>
      <aside class="qz-side" data-side hidden></aside>
      <aside class="qz-below" data-below hidden></aside>
    </form>
    <div class="qz-note" data-note hidden></div>
  </div>
  <script type="application/json" data-form-def set:html={JSON.stringify(prepared)} />
  <script type="application/json" data-config set:html={JSON.stringify(config)} />
</section>

<style is:global>
  /* Laid out like the live betterhood.in assessments: the answers, then Previous/Next right below them, so the question,
     its answers and the buttons share one screen. "How to test" sits beside the question on wide screens; "Did you know"
     comes after the buttons. Nothing scrolls inside the card. */
  .qz { padding: 20px 0 64px; background: radial-gradient(70% 60% at 100% 0%, var(--plum-100), transparent 60%), var(--cream); min-height: 70vh; }
  .qz-wrap { max-width: 1100px; }
  .qz-top { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; font-size: 14.5px; }
  .qz-back-link { display: inline-flex; gap: 6px; align-items: center; color: var(--plum-700); font-weight: 600; }
  .qz-step { margin-left: auto; white-space: nowrap; }
  .qz-jump { display: none; }
  .qz-bar { height: 8px; border-radius: 8px; background: var(--plum-100); overflow: hidden; margin-bottom: 18px; }
  .qz-bar span { display: block; height: 100%; width: 0; border-radius: inherit; background: linear-gradient(90deg, var(--plum-600), var(--sun-500)); transition: width 0.5s var(--ease); }

  .qz-card { --qz-pad: clamp(20px, 3.4vw, 40px); display: grid; grid-template-columns: minmax(0, 1fr); grid-template-areas: "main" "nav" "side" "below"; column-gap: 40px; align-items: start; background: #fff; border: 1px solid var(--line); border-radius: var(--r-xl); padding: var(--qz-pad); box-shadow: var(--shadow-md); }
  .qz-main { grid-area: main; display: grid; gap: 20px; align-content: start; min-width: 0; animation: qzin 0.45s var(--ease); }
  .qz-nav { grid-area: nav; display: flex; justify-content: space-between; gap: 12px; margin-top: 22px; }
  .qz-nav [data-next] { margin-left: auto; }
  .qz-side { grid-area: side; display: grid; gap: 16px; align-content: start; min-width: 0; }
  .qz-below { grid-area: below; min-width: 0; }
  .qz-side:not([hidden]), .qz-below:not([hidden]) { margin-top: 24px; }
  @media (min-width: 861px) {
    .qz-card.has-side { grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr); grid-template-areas: "main side" "nav side" "below below"; grid-template-rows: auto 1fr auto; }
    .qz-card.has-side .qz-side { margin-top: 0; }
  }
  @keyframes qzin { from { opacity: 0; transform: translateX(14px); } }

  .qz-field { gap: 14px; }
  .qz-q { font: 650 clamp(21px, 2.3vw, 27px)/1.22 var(--font-display); letter-spacing: -0.02em; margin-bottom: 14px; }
  .qz-hint { color: var(--ink-mute); font-size: 14.5px; margin-top: -8px; }
  .qz-opts { display: grid; gap: 8px; }
  .qz-opt { position: relative; display: flex; align-items: center; gap: 12px; padding: 11px 16px; border-radius: var(--r-md); border: 1.5px solid var(--line-strong); cursor: pointer; transition: border-color 0.2s var(--ease), background 0.2s var(--ease), box-shadow 0.2s var(--ease); background: #fff; }
  .qz-opt:hover { border-color: var(--plum-300); background: var(--plum-50); }
  .qz-opt input { position: absolute; opacity: 0; pointer-events: none; }
  .qz-opt .tick { flex: none; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--line-strong); display: grid; place-items: center; transition: all 0.2s; color: transparent; }
  .qz-opt.multi .tick { border-radius: 6px; }
  .qz-opt:has(input:checked) { border-color: var(--plum-700); background: var(--plum-50); box-shadow: 0 0 0 3px var(--plum-100); }
  .qz-opt:has(input:checked) .tick { background: var(--plum-700); border-color: var(--plum-700); color: #fff; }
  .qz-opt:has(input:focus-visible) { outline: 3px solid var(--sun-500); outline-offset: 2px; }
  .qz-opt .lbl { font-weight: 550; line-height: 1.35; }
  .qz-opt .lbl small { display: block; font-weight: 400; color: var(--ink-mute); margin-top: 2px; }
  /* short answers (A. 120 degrees, Yes / No…) sit side by side */
  .qz-opts.short { display: flex; flex-wrap: wrap; }
  .qz-opts.short .qz-opt { flex: 0 1 auto; white-space: nowrap; padding-right: 22px; }

  /* Required-answer message: a quiet line under the question, like the live site. Nothing moves or gets covered. */
  .qz-field.invalid .qz-opt, .qz-field.invalid .qz-scale span { border-color: #c2410c; }
  .field.invalid .input { border-color: #c2410c; }
  .qz-ferr { color: #b42318; font-size: 14px; font-weight: 500; margin-top: -4px; }

  .qz-scale { display: grid; grid-template-columns: repeat(11, 1fr); gap: 6px; }
  .qz-scale label { position: relative; cursor: pointer; }
  .qz-scale input { position: absolute; opacity: 0; }
  .qz-scale span { display: grid; place-items: center; height: 50px; border-radius: 12px; font: 700 18px var(--font-display); background: hsl(calc(140 - var(--i) * 14) 70% 92%); color: hsl(calc(140 - var(--i) * 14) 60% 28%); border: 2px solid transparent; transition: transform 0.2s var(--ease), border-color 0.2s; }
  .qz-scale label:hover span { transform: translateY(-3px); }
  .qz-scale input:checked + span { border-color: var(--plum-900); transform: translateY(-4px) scale(1.05); box-shadow: var(--shadow-md); }
  .qz-scale input:focus-visible + span { outline: 3px solid var(--sun-500); }
  .qz-scale-desc { padding: 10px 14px; border-radius: var(--r-md); background: var(--plum-50); font-weight: 550; }
  .qz-scale-ends { display: flex; justify-content: space-between; font-size: 13px; color: var(--ink-mute); }
  .qz-inputs { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }

  .qz-html .assessment_heading, .qz-html h2 { font: 700 clamp(28px, 3.6vw, 42px)/1.08 var(--font-display); letter-spacing: -0.03em; margin-bottom: 10px; }
  .qz-html .assessment_heading span, .qz-html h2 span, .qz-html h3 span { color: var(--plum-600); font-style: italic; font-weight: 500; }
  .qz-html p { color: var(--ink-soft); margin-top: 8px; }
  .qz-html h4 { font: 650 20px var(--font-display); color: var(--plum-700); }
  .qz-html h3 { font: 650 20px var(--font-display); margin-bottom: 6px; }
  .qz-html img { border-radius: var(--r-md); margin-top: 12px; max-height: 300px; width: auto; }
  .qz-consent a, .qz-note a { color: var(--plum-700); text-decoration: underline; }

  /* How to test / Did you know */
  .qz-side .dyk_wrapper, .qz-below .dyk_wrapper { padding: 18px 20px; border-radius: var(--r-lg); background: var(--sun-100); border: 1px solid var(--sun-200); }
  .qz-side .dyk_wrapper .heading, .qz-below .dyk_wrapper .heading { display: flex; align-items: center; gap: 10px; }
  .qz-side .dyk_wrapper .heading img, .qz-below .dyk_wrapper .heading img { width: 30px; height: 30px; margin: 0; }
  .qz-side .dyk_wrapper h3, .qz-below .dyk_wrapper h3 { margin: 0; }
  .qz-side .right_col { padding: 18px 20px; border-radius: var(--r-lg); background: var(--plum-50); }
  .qz-side img { border-radius: var(--r-md); margin-top: 10px; max-height: 240px; width: auto; }
  .qz-below .qz-html p, .qz-side .qz-html p { margin-top: 6px; }

  /* the form's own privacy note, under the card on every step (as on the live site) */
  .qz-note { margin-top: 16px; padding: 14px 18px; border-radius: var(--r-md); background: rgba(255, 255, 255, 0.6); font-size: 13px; line-height: 1.5; color: var(--ink-mute); text-align: center; }
  .qz-note p { margin: 0; }

  .qz-done { text-align: center; display: grid; gap: 16px; justify-items: center; padding: 12px 0; }
  .qz-ring { --p: 0; width: 180px; height: 180px; border-radius: 50%; display: grid; place-items: center; background: conic-gradient(var(--plum-700) calc(var(--p) * 1%), var(--plum-100) 0); }
  .qz-ring > div { width: 146px; height: 146px; border-radius: 50%; background: #fff; display: grid; place-items: center; align-content: center; }
  .qz-ring strong { font: 700 46px/1 var(--font-display); color: var(--plum-700); }
  .qz-ring span { font-size: 13px; color: var(--ink-mute); }
  .qz-bars { width: 100%; max-width: 520px; display: grid; gap: 12px; text-align: left; }
  .qz-bars div { display: grid; grid-template-columns: 100px 1fr 54px; gap: 12px; align-items: center; font-weight: 600; font-size: 15px; }
  .qz-bars i { height: 10px; border-radius: 10px; background: var(--plum-100); overflow: hidden; }
  .qz-bars b { display: block; height: 100%; background: linear-gradient(90deg, var(--sun-500), var(--mint-600)); border-radius: inherit; }
  .qz-actions { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 8px; }

  @media (max-width: 860px) {
    /* phones: the side notes follow the buttons; a "How to test ↓" link jumps to them on test steps */
    .qz-jump:not([hidden]) { display: inline-flex; align-items: center; gap: 4px; padding: 5px 12px; border-radius: 999px; border: 1px solid var(--plum-300); background: var(--plum-50); color: var(--plum-700); font: 600 13px var(--font-body, inherit); cursor: pointer; white-space: nowrap; }
    body:has(.qz) .ticker, body:has(.qz) .wa-float { display: none; }
  }
  @media (max-width: 560px) {
    .qz { padding: 8px 0 40px; }
    .qz-wrap { padding-inline: 12px; }
    .qz-top { margin-bottom: 6px; font-size: 13.5px; gap: 8px; }
    .qz-bar { height: 6px; margin-bottom: 10px; }
    .qz-card { --qz-pad: 16px; border-radius: var(--r-lg); }
    .qz-main { gap: 14px; }
    .qz-field { gap: 10px; }
    .qz-q { font-size: 19px; line-height: 1.25; margin-bottom: 10px; }
    .qz-hint { margin-top: -6px; font-size: 13.5px; }
    .qz-opts { gap: 7px; }
    .qz-opt { padding: 10px 12px; gap: 10px; }
    .qz-opt .tick { width: 20px; height: 20px; }
    .qz-opt .lbl { font-size: 15px; line-height: 1.3; }
    .qz-opts.dense { gap: 5px; }
    .qz-opts.dense .qz-opt { padding: 5px 12px; min-height: 40px; }
    .qz-opts.dense .qz-opt .lbl { font-size: 14px; line-height: 1.25; }
    .qz-scale { grid-template-columns: repeat(6, 1fr); }
    .qz-scale span { height: 44px; }
    .qz-scale-desc { padding: 9px 12px; font-size: 14.5px; }
    .qz-html .assessment_heading, .qz-html h2 { font-size: 26px; }
    .qz-html p { font-size: 15px; }
    .qz-html img { max-height: 180px; }
    .qz-nav { margin-top: 10px; }
    .qz-nav .btn-lg { min-height: 48px; padding: 10px 20px; }
    .qz-side .dyk_wrapper, .qz-below .dyk_wrapper, .qz-side .right_col { padding: 14px 16px; }
    .qz-note { padding: 12px 14px; font-size: 12.5px; }
  }
  @media (max-width: 400px) { .qz-back-link .lbl-long { display: none; } .qz-back-link > span { text-transform: capitalize; } }
  .embed .qz { padding-top: 10px; }
</style>


<script>
  import { QuizEngine, type Field, type FormDef } from "../scripts/quiz-engine";
  import { recordSubmission, submitLead } from "../scripts/forms";
  import { fromApp, isEmbedded, toApp, waitForApp } from "../scripts/embed";
  import { href } from "../scripts/base";
  import { appLink } from "../scripts/app-link";

  const root = document.querySelector<HTMLElement>("[data-quiz]")!;
  const form: FormDef = JSON.parse(root.querySelector("[data-form-def]")!.textContent!);
  const cfg = JSON.parse(root.querySelector("[data-config]")!.textContent!);
  const engine = new QuizEngine(form);
  const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
  const main = $<HTMLElement>("[data-main]"), side = $<HTMLElement>("[data-side]"), below = $<HTMLElement>("[data-below]");
  const next = $<HTMLButtonElement>("[data-next]"), prev = $<HTMLButtonElement>("[data-prev]");
  const card = $<HTMLElement>("[data-form]"), jump = $<HTMLButtonElement>("[data-jump]"), note = $<HTMLElement>("[data-note]");

  // Phones: "How to test" follows the buttons, so a small link at the top jumps down to it.
  jump.addEventListener("click", () => side.scrollIntoView({ behavior: "smooth", block: "start" }));
  // After a step change, bring the top of the quiz back into view if you had scrolled past it.
  function frameIntoView() {
    const top = root.getBoundingClientRect().top + scrollY - (document.getElementById("topbar")?.offsetHeight ?? 0);
    if (scrollY > top + 4) scrollTo({ top: Math.max(top, 0), behavior: "smooth" });
  }

  const CONTACT = /^(first name|full name|email|phone number)$/i;
  const isQuestion = (f: Field) => !f.hidden && ["checkbox", "quiz", "radio", "select"].includes(f.type);
  const isInput = (f: Field) => !f.hidden && ["text", "email", "phone", "number", "textarea"].includes(f.type);
  const maxPage = Math.max(...form.fields.map((f) => f.page));
  // Inside the Betterhood app the patient is signed in: no contact questions, and the app logs the result.
  const embedded = isEmbedded();
  const askContact = (f: Field) => !(embedded && CONTACT.test(f.label));
  const pages = [...Array(maxPage).keys()].map((i) => i + 1);
  const total = pages.length;
  $("[data-steps]").textContent = String(total);

  let idx = 0;
  const consent = form.fields.filter((f) => f.type === "html" && /consent/.test(f.css)).map((f) => f.html).join("");
  note.innerHTML = consent;
  note.hidden = !consent;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const fieldsOn = (page: number) => form.fields.filter((f) => f.page === page && engine.shown(f.id));
  const val = (id: number) => engine.values[id];
  // A page with nothing to answer (only info text, or fields hidden by logic) is skipped.
  const blank = (page: number) => fieldsOn(page).every((f) => f.type === "html" || f.hidden || !askContact(f));
  /** Index of the next step to show after step i (total = past the end). */
  const after = (i: number) => { let j = i + 1; while (j < pages.length && blank(pages[j])) j++; return j; };
  const before = (i: number) => { let j = i - 1; while (j > 0 && j < pages.length && blank(pages[j])) j--; return Math.max(0, j); };

  function optLabel(label: string) {
    // "A. Lift at least 10 kgs | so I can carry…" -> main + sub line
    const [a, b] = label.split("|");
    return b ? `${esc(a.trim())}<small>${esc(b.trim())}</small>` : esc(label);
  }
  function renderQuestion(f: Field) {
    const multi = f.type === "checkbox";
    const opts = (f.choices ?? []).filter((c) => !(f.type === "select" && (c.value === "" || c.label === "Select")));
    const isScale = /pain on a scale/i.test(f.label) && opts.length >= 10;
    const label = f.label.replace(/\s*\(Options to presented as a visual scale\)/i, "");
    const cur = val(f.id);
    if (isScale) {
      return `<fieldset class="qz-field" data-id="${f.id}"><legend class="qz-q">${esc(label)}</legend>
        <div class="qz-scale" role="radiogroup">${opts.map((c, i) => `<label><input type="radio" name="f${f.id}" value="${esc(c.value)}" data-desc="${esc(c.label)}" ${cur === c.value ? "checked" : ""}><span style="--i:${i}">${i}</span></label>`).join("")}</div>
        <div class="qz-scale-ends"><span>No pain</span><span>Unspeakable</span></div>
        <p class="qz-scale-desc" data-scale-desc>${cur ? esc(opts.find((o) => o.value === cur)?.label ?? "") : "Tap a number to describe your pain"}</p></fieldset>`;
    }
    return `<fieldset class="qz-field" data-id="${f.id}"><legend class="qz-q">${esc(label)}</legend>
      ${multi ? `<p class="qz-hint">${esc(f.description || "Choose all that apply.")}</p>` : f.description ? `<p class="qz-hint">${esc(f.description)}</p>` : ""}
      <div class="qz-opts${opts.length > 5 ? " dense" : ""}${opts.every((c) => c.label.length <= 22 && !c.label.includes("|")) ? " short" : ""}">${opts.map((c) => {
        const on = Array.isArray(cur) ? cur.includes(c.value) : cur === c.value;
        return `<label class="qz-opt ${multi ? "multi" : ""}"><input type="${multi ? "checkbox" : "radio"}" name="f${f.id}" value="${esc(c.value)}" ${on ? "checked" : ""}><span class="tick">✓</span><span class="lbl">${optLabel(c.label)}</span></label>`;
      }).join("")}</div></fieldset>`;
  }
  function renderInput(f: Field, required = f.required) {
    const t = f.type === "email" ? "email" : f.type === "phone" ? "tel" : f.type === "number" ? "number" : "text";
    const ac = /first|full/i.test(f.label) ? "given-name" : t === "email" ? "email" : t === "tel" ? "tel" : "off";
    const v = val(f.id);
    return `<div class="field" data-id="${f.id}"><label for="i${f.id}">${esc(f.label)}${required ? " *" : ""}</label>
      <input class="input" id="i${f.id}" name="f${f.id}" type="${t}" ${required ? "required" : ""} autocomplete="${ac}" ${t === "tel" ? 'inputmode="tel" pattern="[0-9+ ]{10,15}"' : ""} ${t === "number" ? 'inputmode="numeric" min="1" max="250"' : ""} value="${esc(typeof v === "string" ? v : "")}"></div>`;
  }
  function render() {
    const page = pages[idx];
    let mainHtml = "", sideHtml = "", belowHtml = "";
    for (const f of fieldsOn(page)) {
      if (f.type === "html") {
        if (/consent/.test(f.css)) continue; // shown under the card
        const html = `<div class="qz-html">${f.html}</div>`;
        // "How to test" (and the pain forms' "Did you know") sit beside the question; the health forms' "Did you know" goes below
        if (/right_html/.test(f.css)) sideHtml += html;
        else if (/dyk_html/.test(f.css)) belowHtml += html;
        else mainHtml += html;
      } else if (isQuestion(f)) mainHtml += renderQuestion(f);
      else if (isInput(f) && askContact(f)) mainHtml += renderInput(f);
    }
    main.innerHTML = mainHtml;
    // group stray inputs (final contact step on pain forms) into a grid
    const loose = [...main.querySelectorAll<HTMLElement>(":scope > .field")];
    if (loose.length) { const g = document.createElement("div"); g.className = "qz-inputs"; loose[0].before(g); loose.forEach((l) => g.append(l)); }
    side.innerHTML = sideHtml; side.hidden = !sideHtml;
    below.innerHTML = belowHtml; below.hidden = !belowHtml;
    card.classList.toggle("has-side", !!sideHtml);
    jump.hidden = !/how to test/i.test(side.textContent ?? "");
    main.style.animation = "none"; void main.offsetWidth; main.style.animation = "";

    $("[data-step]").textContent = String(idx + 1);
    const pct = Math.round((idx / total) * 100);
    $<HTMLElement>("[data-bar]").style.width = `${pct}%`;
    $(".qz-bar").setAttribute("aria-valuenow", String(pct));
    prev.hidden = idx === 0;
    const last = after(idx) >= total;
    next.textContent = idx === 0 ? "Start Assessment" : last ? "Submit Assessment" : "Next";
    if (idx > 0) (main.querySelector("input, select") as HTMLElement | null)?.focus({ preventScroll: true });
  }

  function read() {
    main.querySelectorAll<HTMLElement>("[data-id]").forEach((el) => {
      const id = +el.dataset.id!;
      const f = engine.byId.get(id)!;
      if (f.type === "checkbox") engine.values[id] = [...el.querySelectorAll<HTMLInputElement>("input:checked")].map((i) => i.value);
      else if (el.querySelector("input[type=radio]")) engine.values[id] = el.querySelector<HTMLInputElement>("input:checked")?.value ?? "";
      else { const i = el.querySelector<HTMLInputElement | HTMLSelectElement>("input, select"); if (i) engine.values[id] = i.value.trim(); }
    });
  }
  function clearErrors(scope: ParentNode = main) {
    scope.querySelectorAll(".qz-ferr").forEach((e) => e.remove());
    scope.querySelectorAll(".invalid").forEach((e) => e.classList.remove("invalid"));
  }
  function flag(el: HTMLElement, msg: string) {
    el.classList.add("invalid");
    el.insertAdjacentHTML("beforeend", `<p class="qz-ferr" role="alert">${esc(msg)}</p>`);
  }
  function validate() {
    clearErrors();
    let first: HTMLElement | null = null;
    for (const el of main.querySelectorAll<HTMLElement>("fieldset[data-id]")) {
      const f = engine.byId.get(+el.dataset.id!)!;
      const v = engine.values[f.id];
      if (f.required && (!v || (Array.isArray(v) && !v.length))) { flag(el, "This field is required."); first ??= el; }
    }
    for (const i of main.querySelectorAll<HTMLInputElement>("input.input")) {
      if (!i.checkValidity()) { const box = i.closest<HTMLElement>(".field")!; flag(box, i.validity.valueMissing ? "This field is required." : i.validationMessage || "Please check this field."); first ??= box; }
    }
    if (!first) return true;
    const r = first.getBoundingClientRect();
    if (r.top < 80 || r.bottom > innerHeight) first.scrollIntoView({ behavior: "smooth", block: "center" });
    return false;
  }

  main.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.dataset.desc !== undefined) main.querySelector("[data-scale-desc]")!.textContent = t.dataset.desc!;
    // "None of the above" clears the other ticks, and vice versa
    if (t.type === "checkbox") {
      const box = t.closest(".qz-opts")!;
      const none = (x: HTMLInputElement) => /^none of the above/i.test(x.value);
      if (t.checked && none(t)) box.querySelectorAll<HTMLInputElement>("input").forEach((x) => x !== t && (x.checked = false));
      else if (t.checked) box.querySelectorAll<HTMLInputElement>("input").forEach((x) => none(x) && (x.checked = false));
    }
    clearErrors(t.closest(".qz-field, .field") ?? main);
  });

  $<HTMLFormElement>("[data-form]").addEventListener("submit", (e) => {
    e.preventDefault();
    read();
    if (!validate()) return;
    const n = after(idx);
    if (n < total) {
      idx = n;
      render();
      frameIntoView();
    } else finish();
  });
  prev.addEventListener("click", () => {
    read();
    idx = before(idx);
    render();
    frameIntoView();
  });

  function byLabel(re: RegExp) { return form.fields.find((f) => re.test(f.label)); }
  function finish() {
    const name = String(engine.values[(byLabel(/^(first name|full name)$/i) ?? { id: -1 }).id] ?? "").trim();
    const email = String(engine.values[(byLabel(/^email$/i) ?? { id: -1 }).id] ?? "");
    const phone = String(engine.values[(byLabel(/^phone number$/i) ?? { id: -1 }).id] ?? "");
    const store = JSON.parse(localStorage.getItem("bh_results") || "{}");
    const date = new Date().toISOString();
    let record: Record<string, unknown>;
    let go = "";

    if (cfg.kind === "pain") {
      const totals = Object.entries(cfg.totals as Record<string, string>).map(([id, cat]) => ({ cat, score: engine.num(+id) }));
      const best = totals.reduce((a, b) => (b.score > a.score ? b : a));
      const adv = byLabel(/^critical advisory$/i);
      record = { kind: "pain", area: cfg.area, title: cfg.title, cat: best.cat, condition: cfg.conditions[best.cat], totals, advisory: adv ? engine.shown(adv.id) : false, name, date, result: cfg.results[best.cat] };
      go = href(`/${cfg.results[best.cat]}/`);
    } else {
      const score = (re: RegExp) => { const f = byLabel(re); return f ? Math.round(engine.num(f.id) * 10) / 10 : null; };
      record = { kind: cfg.kind, area: cfg.area, title: cfg.title, name, date, overall: score(/^overall score$/i) ?? score(/^average score$/i), strength: score(/^total \(strength\)$/i), balance: score(/^total \(balance\)$/i), mobility: score(/^total \(mobility\)$/i) };
    }
    store[cfg.slug] = record;
    const history = JSON.parse(localStorage.getItem("bh_history") || "[]");
    history.push({ slug: cfg.slug, ...record });
    try { localStorage.setItem("bh_results", JSON.stringify(store)); localStorage.setItem("bh_history", JSON.stringify(history.slice(-60))); if (name) localStorage.setItem("bh_name", name); } catch {}

    // In the app: hand the result over (the app saves it to the patient's account and shows next steps).
    // If the app doesn't confirm, carry on exactly as on the website.
    if (embedded) {
      const acked = waitForApp("bh:ack", 4000);
      if (toApp({ type: "bh:assessment-result", result: { slug: cfg.slug, ...record } })) {
        showSaving();
        acked.then((ok) => { if (!ok) (go ? (location.href = go) : showScores(record)); });
        return;
      }
    }

    // lead capture only when PUBLIC_FORM_ENDPOINT is configured (never interrupt with a mail client here)
    if (import.meta.env.PUBLIC_FORM_ENDPOINT) submitLead(`assessment:${cfg.slug}`, { name, email, phone, ...record, answers: engine.values }, { record: false }).catch(() => {});
    // The result (not the answers) also goes to the Betterhood API for the admin dashboard. In the app, the app saves it instead.
    recordSubmission("assessment", cfg.slug, { ...record, name, email, phone });

    if (go) { location.href = go; return; }
    showScores(record);
  }

  function showSaving() {
    $<HTMLElement>("[data-bar]").style.width = "100%";
    card.classList.remove("has-side"); side.hidden = true; below.hidden = true; jump.hidden = true;
    main.innerHTML = `<div class="qz-done"><span class="badge badge-mint">Assessment complete</span><h2 class="h2">Saving your result…</h2><p class="lead">Just a moment.</p></div>`;
    $(".qz-nav").remove();
  }

  // The app shares what it already knows about the patient (name, phone, age, sex) so we don't ask again.
  type Prefill = { name?: string; email?: string; phone?: string; age?: number; sex?: "F" | "M" | "O" };
  if (embedded) {
    fromApp<{ type: string; prefill?: Prefill }>("bh:context", ({ prefill: p }) => {
      if (!p) return;
      const fill = (re: RegExp, v: string | undefined) => {
        const f = byLabel(re);
        if (f && v && !engine.values[f.id]) engine.values[f.id] = v;
      };
      fill(/^(first name|full name)$/i, p.name);
      fill(/^email$/i, p.email);
      fill(/^phone number$/i, p.phone);
      fill(/^age \(in years\)/i, p.age ? String(p.age) : undefined);
      fill(/^gender/i, p.sex === "F" ? "Female" : p.sex === "M" ? "Male" : undefined);
      if (idx === 0) render();
    });
    toApp({ type: "bh:ready", flow: "assessment", slug: cfg.slug });
  }

  function showScores(r: any) {
    const toAppHref = appLink(cfg.slug, r);
    const pct = Math.round(((r.overall ?? 0) / 10) * 100);
    const bars = [["Strength", r.strength], ["Balance", r.balance], ["Mobility", r.mobility]].filter(([, v]) => v !== null);
    $<HTMLElement>("[data-bar]").style.width = "100%";
    card.classList.remove("has-side"); side.hidden = true; below.hidden = true; jump.hidden = true;
    main.innerHTML = `<div class="qz-done">
      <span class="badge badge-mint">Assessment complete</span>
      <h2 class="h2">${r.name ? `Well done, ${esc(r.name)}!` : "Well done!"}</h2>
      <p class="lead">${cfg.kind === "longevity" ? "Here's the longevity target you've set for your musculoskeletal health." : `Here's your latest ${esc(cfg.title.toLowerCase())} score — combining strength, balance and mobility.`}</p>
      <div class="qz-ring" style="--p:${pct}"><div><strong>${r.overall ?? "–"}</strong><span>out of 10</span></div></div>
      <div class="qz-bars">${bars.map(([k, v]) => `<div><span>${k}</span><i><b style="width:${(+v! / 10) * 100}%"></b></i><span>${v}/10</span></div>`).join("")}</div>
      <div class="qz-actions">${toAppHref ? `<a class="btn btn-lg" href="${toAppHref}">Track it in the betterhood app →</a><a class="btn btn-ghost btn-lg" href="${href(cfg.corner)}">Open my betterYou corner</a>` : `<a class="btn btn-lg" href="${href(cfg.corner)}">Open my betterYou corner →</a>`}<a class="btn btn-ghost btn-lg" href="${location.pathname}">Retake</a></div>
    </div>`;
    $(".qz-nav").remove();
    $("[data-step]").textContent = String(total);
  }

  render();
</script>

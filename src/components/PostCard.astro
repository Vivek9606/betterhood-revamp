---
import Icon from "./Icon.astro";
import { media } from "../lib/site";
import { formatDate, termName, isVideo, type Post } from "../lib/data";

interface Props { post: Post; variant?: "default" | "row" | "feature"; eager?: boolean }
const { post, variant = "default", eager = false } = Astro.props;
const tag = post.concern[0] ? termName("by-health-concern", post.concern[0]) : post.solution[0] ? termName("by-solution", post.solution[0]) : post.inside[0] ? termName("by-what-inside", post.inside[0]) : "";
const video = isVideo(post);
const thumb = post.image?.thumb || (post.videos[0] ? `https://i.ytimg.com/vi/${post.videos[0]}/hqdefault.jpg` : "");
---
<article class:list={["pc card card-hover", `pc-${variant}`]}>
  <a href={`/learn/${post.slug}/`} class="pc-link" aria-label={post.title}></a>
  <div class="media pc-media">
    {thumb ? <img src={media(thumb)} alt={post.image?.alt ?? ""} loading={eager ? "eager" : "lazy"} width="768" height="432" /> : <div class="pc-ph"><Icon name="leaf" size={36} /></div>}
    {video && <span class="pc-play"><Icon name="play" size={18} /></span>}
  </div>
  <div class="pc-body">
    <div class="pc-meta">
      {tag && <span class="badge badge-plum">{tag}</span>}
      <span class="muted">{formatDate(post.date, "short")}</span>
    </div>
    <h3 class="pc-title">{post.title}</h3>
    {variant !== "row" && <p class="pc-ex">{post.excerpt}</p>}
    <div class="pc-foot muted">
      <span><Icon name={video ? "video" : "clock"} size={15} /> {video ? "Video" : `${post.minutes} min read`}</span>
      <span class="pc-go"><Icon name="arrow" size={18} /></span>
    </div>
  </div>
</article>

<style is:global>
  .pc { position: relative; display: flex; flex-direction: column; height: 100%; }
  .pc-link { position: absolute; inset: 0; z-index: 2; border-radius: inherit; }
  .pc-media { aspect-ratio: 16 / 9; }
  .pc-ph { display: grid; place-items: center; height: 100%; color: var(--plum-300); background: linear-gradient(135deg, var(--plum-100), var(--sun-100)); }
  .pc-play { position: absolute; left: 14px; bottom: 14px; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: #fff; color: var(--plum-700); box-shadow: var(--shadow-md); }
  .pc-body { padding: 18px 20px 18px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .pc-meta { display: flex; align-items: center; gap: 10px; font-size: 13px; flex-wrap: wrap; }
  .pc-title { font-size: 19px; line-height: 1.25; letter-spacing: -0.01em; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pc-ex { font-size: 15px; color: var(--ink-soft); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pc-foot { margin-top: auto; display: flex; justify-content: space-between; align-items: center; font-size: 13.5px; padding-top: 6px; }
  .pc-foot span { display: inline-flex; align-items: center; gap: 6px; }
  .pc-go { width: 34px; height: 34px; border-radius: 50%; justify-content: center; background: var(--plum-50); color: var(--plum-700); transition: all 0.3s var(--ease); }
  .pc:hover .pc-go { background: var(--plum-700); color: #fff; transform: rotate(-35deg); }

  .pc-row { flex-direction: row; align-items: stretch; }
  .pc-row .pc-media { width: 38%; aspect-ratio: auto; min-height: 120px; flex: none; }
  .pc-row .pc-body { padding: 14px 16px; }
  .pc-row .pc-title { font-size: 16.5px; }

  .pc-feature .pc-media { aspect-ratio: 16 / 10; }
  .pc-feature .pc-title { font-size: clamp(22px, 2.4vw, 30px); }
  .pc-feature .pc-ex { -webkit-line-clamp: 3; font-size: 16px; }
</style>

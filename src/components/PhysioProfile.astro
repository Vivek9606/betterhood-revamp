  .pp-note :global(svg) { flex: none; margin-top: 2px; }
  .pp-edge { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; padding: 16px 20px; border-radius: var(--r-lg); background: var(--plum-900); color: #e9dbe6; font-size: 14.5px; }

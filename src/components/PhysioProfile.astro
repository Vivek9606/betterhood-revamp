</style>

<script>
  // in-page tabs: highlight the section in view
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".pp-tabs a")];
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((l) => l.classList.toggle("is-on", l.dataset.tab === e.target.id));
      document.querySelector(".pp-tabs a.is-on")?.scrollIntoView({ block: "nearest", inline: "center" });
    });
  }, { rootMargin: "-35% 0px -60% 0px" });
  links.forEach((l) => { const s = document.getElementById(l.dataset.tab!); if (s) io.observe(s); });

  // "show all" specialisations
  document.querySelector<HTMLButtonElement>("[data-more]")?.addEventListener("click", (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    const open = document.querySelector("[data-chips]")!.classList.toggle("is-open");
    b.setAttribute("aria-expanded", String(open));
    b.firstChild!.textContent = open ? "Show less " : `Show all ${document.querySelectorAll("[data-chips] li").length} `;
  });

  // videos load only when played (keeps the page fast)
  document.querySelectorAll<HTMLElement>("[data-yt]").forEach((v) =>
    v.addEventListener("click", () => {
      if (v.querySelector("iframe")) return;
      const f = document.createElement("iframe");
      f.src = `https://www.youtube-nocookie.com/embed/${v.dataset.yt}?autoplay=1&rel=0`;
      f.title = v.dataset.title || "Video";
      f.allow = "autoplay; encrypted-media; picture-in-picture";
      f.allowFullscreen = true;
      v.replaceChildren(f);
    }),
  );

  // gallery lightbox
  const lb = document.querySelector<HTMLDialogElement>(".pp-lb");
  if (lb) {
    const photos: { src: string; alt: string; caption: string }[] = JSON.parse(lb.querySelector("script")!.textContent!);
    const img = lb.querySelector("img")!, cap = lb.querySelector("figcaption")!;
    let i = 0;
    const show = (n: number) => { i = (n + photos.length) % photos.length; img.src = photos[i].src; img.alt = photos[i].alt; cap.textContent = `${photos[i].caption}  ·  ${i + 1} / ${photos.length}`; };
    document.querySelectorAll<HTMLButtonElement>("[data-lb]").forEach((b) => b.addEventListener("click", () => { show(+b.dataset.lb!); lb.showModal(); }));
    lb.querySelectorAll<HTMLButtonElement>("[data-lb-step]").forEach((b) => b.addEventListener("click", () => show(i + +b.dataset.lbStep!)));
    lb.querySelector("[data-lb-close]")!.addEventListener("click", () => lb.close());
    lb.addEventListener("click", (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener("keydown", (e) => { if (e.key === "ArrowRight") show(i + 1); if (e.key === "ArrowLeft") show(i - 1); });
  }
</script>

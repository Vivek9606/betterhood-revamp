---
// Betty, the betterhood red panda (in a betterhood hoodie), keeps readers company on article pages.
//   - peeks from the bottom-left corner; says hi once per session and cheers at the end of the article
//   - when a paragraph that mentions a betterhood product scrolls up past the trigger line, Betty pushes a
//     surprise box into view and a little gift appears on that sentence; opening either reveals the product
//   - unopened surprises park in Betty's tray (click Betty)
// The paragraphs are marked at build time by processArticle({ mentions }) (src/lib/article.ts):
// [data-betty="<handle>"] on the block, [data-betty-mention="<handle>"] on the link / product name.
// Config + all copy: src/data/betty.json. The artwork is an original stand-in until the official Betty art lands.
import BETTY from "../data/betty.json";
import MARK_SVG from "../../public/img/mark.svg?raw";

type Product = { handle: string; title: string; type?: string; price: number; compare: number; image: string };
type Part = { t: string; bold?: boolean };
interface Props { products: Product[]; slug: string; offer: Part[]; cta: string }
const { products, slug, offer, cta } = Astro.props;
const C = BETTY.copy;
const shopImg = (u: string, w = 600) => (u.includes("cdn.shopify.com") ? `${u}${u.includes("?") ? "&" : "?"}width=${w}` : u);
const data = {
  slug,
  copy: C,
  triggerLine: BETTY.triggerLine,
  parkAfterMs: BETTY.parkAfterMs,
  products: Object.fromEntries(products.map((p) => [p.handle, { t: p.title, y: p.type || "", p: p.price, c: p.compare, i: shopImg(p.image) }])),
};
// the "b" from the betterhood logo (public/img/logo.svg), for the hoodie
const MARK = MARK_SVG.match(/ d="([^"]+)"/)![1];
---

<div class="betty" data-betty-root hidden>
  <div class="b-bubble" role="status" aria-live="polite"><p></p></div>

  <button class="b-dock" type="button" aria-label={C.dockLabel} aria-expanded="false" aria-controls="b-tray">
    <svg class="b-panda" viewBox="0 0 120 132" aria-hidden="true">
      <!-- tail -->
      <g class="b-tail">
        <path d="M84 124 C106 122 113 100 105 80" fill="none" stroke="#c4532a" stroke-width="17" stroke-linecap="round" />
        <path d="M84 124 C106 122 113 100 105 80" fill="none" stroke="#7a2f14" stroke-width="17" stroke-dasharray="6 8" stroke-dashoffset="-4" />
      </g>
      <!-- hood behind head -->
      <ellipse cx="60" cy="80" rx="40" ry="20" fill="var(--plum-800, #4a1a55)" />
      <!-- body: hoodie -->
      <path d="M22 132 C22 104 34 88 60 88 C86 88 98 104 98 132 Z" fill="var(--plum-700, #5b2168)" />
      <path d="M50 90 L50 104 M70 90 L70 104" stroke="#fff8f0" stroke-width="2" stroke-linecap="round" />
      <circle cx="50" cy="105.5" r="1.8" fill="#fff8f0" /><circle cx="70" cy="105.5" r="1.8" fill="#fff8f0" />
      <path transform="translate(53.5 106) scale(0.058)" d={MARK} fill="var(--sun-500, #ffb547)" />
      <!-- arms -->
      <g class="b-arm-l"><path d="M30 104 C22 112 22 122 28 126" fill="none" stroke="var(--plum-700, #5b2168)" stroke-width="12" stroke-linecap="round" /><circle cx="29" cy="126" r="6" fill="#3b1d14" /></g>
      <g class="b-arm-r"><path d="M90 104 C98 112 98 122 92 126" fill="none" stroke="var(--plum-700, #5b2168)" stroke-width="12" stroke-linecap="round" /><circle cx="91" cy="126" r="6" fill="#3b1d14" /></g>
      <!-- head -->
      <g class="b-head">
        <g class="b-ear-l"><path d="M21 37 C15 12 29 1 47 15 Z" fill="#c4532a" /><path d="M24 34 C20 14 30 6 44 16 Z" fill="#fff8f0" /><path d="M28 30 C26 18 32 13 41 19 Z" fill="#3b1d14" /></g>
        <g class="b-ear-r"><path d="M99 37 C105 12 91 1 73 15 Z" fill="#c4532a" /><path d="M96 34 C100 14 90 6 76 16 Z" fill="#fff8f0" /><path d="M92 30 C94 18 88 13 79 19 Z" fill="#3b1d14" /></g>
        <ellipse cx="60" cy="48" rx="36" ry="29" fill="#c4532a" />
        <ellipse cx="60" cy="40" rx="26" ry="16" fill="#d8693a" opacity=".7" />
        <ellipse cx="35" cy="57" rx="11" ry="9" fill="#fff8f0" />
        <ellipse cx="85" cy="57" rx="11" ry="9" fill="#fff8f0" />
        <ellipse cx="60" cy="62" rx="15" ry="11" fill="#fff8f0" />
        <ellipse cx="46" cy="35" rx="5.5" ry="3.4" fill="#fff8f0" />
        <ellipse cx="74" cy="35" rx="5.5" ry="3.4" fill="#fff8f0" />
        <path d="M47 50 C45 56 43 60 41 66" stroke="#7a2f14" stroke-width="4" stroke-linecap="round" fill="none" />
        <path d="M73 50 C75 56 77 60 79 66" stroke="#7a2f14" stroke-width="4" stroke-linecap="round" fill="none" />
        <g class="b-eyes">
          <ellipse cx="47" cy="46" rx="4.4" ry="4.8" fill="#24120c" /><circle cx="48.4" cy="44.4" r="1.4" fill="#fff" />
          <ellipse cx="73" cy="46" rx="4.4" ry="4.8" fill="#24120c" /><circle cx="74.4" cy="44.4" r="1.4" fill="#fff" />
        </g>
        <path d="M55.5 56.5 Q60 54.5 64.5 56.5 Q62 61 60 61 Q58 61 55.5 56.5 Z" fill="#24120c" />
        <path d="M56 65 Q60 68.5 64 65" stroke="#24120c" stroke-width="1.8" fill="none" stroke-linecap="round" />
      </g>
    </svg>
    <span class="b-count" aria-hidden="true"></span>
  </button>

  <div class="b-tray" id="b-tray" hidden>
    <p class="b-tray-h">{C.trayTitle}</p>
    <ul class="b-tray-list"></ul>
    <p class="b-tray-empty">{C.trayEmpty}</p>
    <button class="b-hide" type="button">{C.hide}</button>
  </div>

  <button class="b-box" type="button" hidden>
    <svg viewBox="0 0 64 64" aria-hidden="true">
      <rect x="10" y="29" width="44" height="30" rx="4" fill="var(--plum-600, #6f2b7d)" />
      <rect x="29" y="29" width="6" height="30" fill="var(--sun-500, #ffb547)" />
      <g class="b-lid">
        <rect x="6" y="20" width="52" height="11" rx="3" fill="var(--plum-800, #4a1a55)" />
        <rect x="29" y="20" width="6" height="11" fill="var(--sun-500, #ffb547)" />
        <path d="M32 20 C22 6 14 12 20 18 C23 21 28 20 32 20 Z M32 20 C42 6 50 12 44 18 C41 21 36 20 32 20 Z" fill="var(--sun-500, #ffb547)" />
      </g>
    </svg>
    <span class="b-spark" aria-hidden="true"></span>
  </button>
</div>

<dialog class="b-reveal" aria-labelledby="b-r-title">
  <button class="b-x" type="button" aria-label={C.close}>×</button>
  <div class="b-r-stage" aria-hidden="true">
    <span class="b-confetti"></span>
    <img class="b-r-img" alt="" width="300" height="300" decoding="async" />
    <svg class="b-r-gift" viewBox="0 0 64 64">
      <rect x="10" y="29" width="44" height="30" rx="4" fill="var(--plum-600, #6f2b7d)" />
      <rect x="29" y="29" width="6" height="30" fill="var(--sun-500, #ffb547)" />
      <g class="b-lid">
        <rect x="6" y="20" width="52" height="11" rx="3" fill="var(--plum-800, #4a1a55)" />
        <rect x="29" y="20" width="6" height="11" fill="var(--sun-500, #ffb547)" />
        <path d="M32 20 C22 6 14 12 20 18 C23 21 28 20 32 20 Z M32 20 C42 6 50 12 44 18 C41 21 36 20 32 20 Z" fill="var(--sun-500, #ffb547)" />
      </g>
    </svg>
  </div>
  <div class="b-r-body">
    <p class="b-r-eyebrow">{C.revealEyebrow}</p>
    <p class="b-r-type"></p>
    <h2 class="b-r-title" id="b-r-title"></h2>
    <p class="b-r-price"><s></s><span class="b-now"></span><em></em></p>
    <p class="b-r-offer">{offer.map((p) => (p.bold ? <strong>{p.t}</strong> : p.t))}</p>
    <div class="b-r-actions">
      <a class="btn b-r-go" href="#" target="_blank" rel="noopener">{cta}</a>
      <button class="btn btn-ghost b-r-back" type="button">{C.keepReading}</button>
    </div>
  </div>
</dialog>

<script type="application/json" id="betty-data" set:html={JSON.stringify(data)} />

<script>
  type P = { t: string; y: string; p: number; c: number; i: string };
  type D = { slug: string; copy: Record<string, string>; triggerLine: number; parkAfterMs: number; products: Record<string, P> };

  const root = document.querySelector<HTMLElement>("[data-betty-root]");
  const dataEl = document.getElementById("betty-data");
  let hiddenForSession = false;
  try { hiddenForSession = sessionStorage.getItem("bh-betty-hidden") === "1"; } catch {}

  if (root && dataEl && !hiddenForSession) {
    const D: D = JSON.parse(dataEl.textContent || "{}");
    const C = D.copy;
    const fill = (s: string, v: Record<string, string | number>) => s.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ""));
    const rupee = (n: number) => `₹${n.toFixed(2)}`;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

    const dock = root.querySelector<HTMLButtonElement>(".b-dock")!;
    const bubble = root.querySelector<HTMLElement>(".b-bubble")!;
    const tray = root.querySelector<HTMLElement>(".b-tray")!;
    const list = root.querySelector<HTMLUListElement>(".b-tray-list")!;
    const count = root.querySelector<HTMLElement>(".b-count")!;
    const box = root.querySelector<HTMLButtonElement>(".b-box")!;
    const dlg = document.querySelector<HTMLDialogElement>(".b-reveal")!;

    root.hidden = false;
    requestAnimationFrame(() => root.classList.add("is-in"));

    // ---------- speech bubble ----------
    let bubbleT = 0;
    const say = (text: string, ms = 5200) => {
      bubble.querySelector("p")!.textContent = text;
      bubble.classList.add("on");
      root.classList.add("is-talk");
      clearTimeout(bubbleT);
      bubbleT = window.setTimeout(() => { bubble.classList.remove("on"); root.classList.remove("is-talk"); }, ms);
    };
    const hush = () => { clearTimeout(bubbleT); bubble.classList.remove("on"); root.classList.remove("is-talk"); };

    // ---------- tray of finds ----------
    const found: string[] = [];
    const opened = new Set<string>();
    const renderTray = () => {
      list.innerHTML = "";
      for (const h of found) {
        const p = D.products[h];
        const li = document.createElement("li");
        const b = document.createElement("button");
        b.type = "button";
        b.className = "b-tray-item" + (opened.has(h) ? " seen" : "");
        b.innerHTML = `<img src="${p.i}" alt="" width="48" height="48" loading="lazy"><span><b></b><small>${rupee(p.p)}</small></span>`;
        b.querySelector("b")!.textContent = p.t;
        b.addEventListener("click", () => { closeTray(); reveal(h); });
        li.append(b);
        list.append(li);
      }
      tray.classList.toggle("has", found.length > 0);
      const unseen = found.filter((h) => !opened.has(h) && h !== active?.h).length;
      count.textContent = unseen ? String(unseen) : "";
      count.classList.toggle("on", unseen > 0);
    };
    const openTray = () => { hush(); tray.hidden = false; dock.setAttribute("aria-expanded", "true"); };
    const closeTray = () => { tray.hidden = true; dock.setAttribute("aria-expanded", "false"); };
    dock.addEventListener("click", () => (tray.hidden ? openTray() : closeTray()));
    document.addEventListener("click", (e) => { if (!tray.hidden && !root.contains(e.target as Node)) closeTray(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !tray.hidden) { closeTray(); dock.focus(); } });
    root.querySelector(".b-hide")!.addEventListener("click", () => {
      try { sessionStorage.setItem("bh-betty-hidden", "1"); } catch {}
      root.classList.remove("is-in");
      document.querySelectorAll(".b-mark").forEach((m) => m.remove());
      setTimeout(() => root.remove(), 400);
    });

    // ---------- the reveal ----------
    const go = dlg.querySelector<HTMLAnchorElement>(".b-r-go")!;
    const reveal = (h: string) => {
      const p = D.products[h];
      if (!p) return;
      const img = dlg.querySelector<HTMLImageElement>(".b-r-img")!;
      img.src = p.i;
      img.alt = p.t;
      dlg.querySelector(".b-r-type")!.textContent = p.y;
      dlg.querySelector(".b-r-title")!.textContent = p.t;
      const sale = p.c > p.p;
      dlg.querySelector(".b-r-price s")!.textContent = sale ? rupee(p.c) : "";
      dlg.querySelector(".b-now")!.textContent = rupee(p.p);
      dlg.querySelector(".b-r-price em")!.textContent = sale ? fill(C.save, { pct: Math.round(((p.c - p.p) / p.c) * 100) }) : "";
      go.href = `https://shop.betterhood.in/products/${h}`;
      dlg.classList.remove("play");
      void dlg.offsetWidth;
      dlg.classList.add("play");
      if (!reduced) confetti();
      dlg.showModal();
      opened.add(h);
      if (!found.includes(h)) found.push(h);
      renderTray();
      document.querySelectorAll(`.b-mark[data-h="${h}"]`).forEach((m) => m.classList.add("seen"));
    };
    const confetti = () => {
      const c = dlg.querySelector<HTMLElement>(".b-confetti")!;
      c.innerHTML = "";
      const colors = ["var(--sun-500)", "var(--plum-500)", "var(--mint-600)", "var(--coral-500)", "#fff"];
      for (let i = 0; i < 26; i++) {
        const s = document.createElement("i");
        const a = (Math.PI * 2 * i) / 26 + Math.random() * 0.3;
        const r = 90 + Math.random() * 80;
        s.style.cssText = `--x:${Math.cos(a) * r}px;--y:${Math.sin(a) * r * 0.75 - 30}px;--r:${Math.random() * 540}deg;background:${colors[i % colors.length]};animation-delay:${0.35 + Math.random() * 0.12}s`;
        c.append(s);
      }
    };
    const shut = () => dlg.close();
    dlg.querySelector(".b-x")!.addEventListener("click", shut);
    dlg.querySelector(".b-r-back")!.addEventListener("click", shut);
    dlg.addEventListener("click", (e) => { if (e.target === dlg) shut(); });

    // ---------- surprises ----------
    let active: { h: string; t: number } | null = null;
    const fired = new Set<string>();
    const sight = new Set<Element>();

    const park = () => {
      if (!active) return;
      const h = active.h;
      clearTimeout(active.t);
      active = null;
      box.classList.remove("in");
      box.classList.add("park");
      root.classList.remove("is-push");
      hush();
      setTimeout(() => { box.hidden = true; box.classList.remove("park"); renderTray(); count.classList.add("pop"); setTimeout(() => count.classList.remove("pop"), 500); next(); }, reduced ? 200 : 520);
    };

    const surprise = (block: Element) => {
      const h = block.getAttribute("data-betty")!;
      if (fired.has(h) || !D.products[h]) return;
      fired.add(h);
      found.push(h);
      // the gift on the sentence
      const mention = block.querySelector(`[data-betty-mention="${h}"]`);
      if (mention && !mention.parentElement?.querySelector(".b-mark")) {
        const mark = document.createElement("button");
        mark.type = "button";
        mark.className = "b-mark";
        mark.dataset.h = h;
        mark.setAttribute("aria-label", fill(C.markLabel, { product: D.products[h].t }));
        mark.innerHTML = box.querySelector("svg")!.outerHTML;
        mark.addEventListener("click", (e) => { e.preventDefault(); if (active?.h === h) { clearTimeout(active.t); active = null; box.hidden = true; box.classList.remove("in"); root.classList.remove("is-push"); hush(); } reveal(h); });
        if ((mention.textContent || "").length <= 32) { const nb = document.createElement("span"); nb.className = "b-nb"; mention.replaceWith(nb); nb.append(mention, mark); }
        else mention.after(mark);
        mention.classList.add("b-lit");
      }
      // Betty is already showing a box: this one goes quietly onto the sentence and into the tray
      if (active) { renderTray(); count.classList.add("pop"); setTimeout(() => count.classList.remove("pop"), 500); return; }
      // Betty pushes the box in
      box.setAttribute("aria-label", fill(C.boxLabel, { product: D.products[h].t }));
      box.dataset.h = h;
      box.hidden = false;
      void box.offsetWidth;
      box.classList.add("in");
      root.classList.add("is-push");
      say(C.tease, D.parkAfterMs);
      active = { h, t: window.setTimeout(park, D.parkAfterMs) };
    };
    const next = () => {
      if (active) return;
      for (const b of document.querySelectorAll("[data-betty]")) if (sight.has(b) && !fired.has(b.getAttribute("data-betty")!)) return surprise(b);
    };
    box.addEventListener("click", () => {
      if (!active) return;
      const h = active.h;
      clearTimeout(active.t);
      active = null;
      box.hidden = true;
      box.classList.remove("in");
      root.classList.remove("is-push");
      hush();
      reveal(h);
    });

    // a block "arrives" when its top crosses the trigger line on the way up the screen (reader scrolling down)
    const line = Math.round((1 - D.triggerLine) * 100);
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          sight.add(e.target);
          if (e.boundingClientRect.top > 0) surprise(e.target);
        } else {
          sight.delete(e.target);
          // scrolled well past it: tidy the box away
          if (active && e.target.getAttribute("data-betty") === active.h && e.boundingClientRect.bottom < 0) park();
        }
      }
    }, { rootMargin: `0px 0px -${line}% 0px` });
    document.querySelectorAll("[data-betty]").forEach((b) => io.observe(b));

    // ---------- hello + well done ----------
    let greeted = false;
    try { greeted = sessionStorage.getItem("bh-betty-greeted") === "1"; } catch {}
    if (!greeted) {
      const onScroll = () => {
        if (scrollY < innerHeight * 0.5) return;
        removeEventListener("scroll", onScroll);
        try { sessionStorage.setItem("bh-betty-greeted", "1"); } catch {}
        if (!active) { say(C.greet, 6000); root.classList.add("is-wave"); setTimeout(() => root.classList.remove("is-wave"), 1800); }
      };
      addEventListener("scroll", onScroll, { passive: true });
    }
    const end = document.querySelector(".a-prose");
    if (end) {
      const s = document.createElement("span");
      s.setAttribute("aria-hidden", "true");
      end.append(s);
      new IntersectionObserver((es, o) => {
        if (es[0].isIntersecting && scrollY > innerHeight) {
          o.disconnect();
          if (!active) { say(C.end, 5000); root.classList.add("is-wave"); setTimeout(() => root.classList.remove("is-wave"), 1800); }
        }
      }).observe(s);
    }
    renderTray();
  }
</script>

<style is:global>
  .betty { position: fixed; z-index: 45; left: clamp(8px, 1.6vw, 22px); bottom: 0; width: 104px; height: 100px; pointer-events: none; transform: translateY(110%); transition: transform 0.7s cubic-bezier(0.34, 1.4, 0.64, 1); }
  .betty.is-in { transform: none; }
  .betty > * { pointer-events: auto; }
  .b-dock { position: absolute; inset: 0; padding: 0; border: 0; background: none; cursor: pointer; -webkit-tap-highlight-color: transparent; }
  .b-dock:focus-visible { outline: 3px solid var(--sun-500); outline-offset: -2px; border-radius: 30px 30px 0 0; }
  .b-panda { position: absolute; left: 0; bottom: -10px; width: 100%; height: auto; overflow: visible; filter: drop-shadow(0 8px 16px rgba(36, 12, 44, 0.28)); transition: transform 0.35s var(--ease); transform-origin: 50% 100%; }
  .b-dock:hover .b-panda { transform: translateY(-6px); }
  .b-head { transform-origin: 60px 70px; transition: transform 0.4s var(--ease); }
  .betty.is-talk .b-head { transform: rotate(-6deg); }
  .b-eyes { transform-origin: 60px 46px; animation: b-blink 5.5s infinite; }
  .b-tail { transform-origin: 88px 124px; animation: b-swish 4s ease-in-out infinite; }
  .b-ear-l { transform-origin: 34px 28px; } .b-ear-r { transform-origin: 86px 28px; }
  .betty.is-talk .b-ear-r { animation: b-twitch 0.6s 0.2s; }
  .b-arm-r { transform-origin: 90px 104px; transition: transform 0.4s var(--ease); }
  .betty.is-push .b-arm-r { animation: b-push 0.9s var(--ease); }
  .betty.is-wave .b-arm-r { animation: b-wave 1.6s ease-in-out; }
  @keyframes b-blink { 0%, 92%, 100% { transform: scaleY(1); } 95% { transform: scaleY(0.1); } }
  @keyframes b-swish { 0%, 100% { transform: rotate(0); } 50% { transform: rotate(-9deg); } }
  @keyframes b-twitch { 50% { transform: rotate(10deg); } }
  @keyframes b-push { 0% { transform: none; } 35% { transform: rotate(-40deg) translateX(-4px); } 60% { transform: rotate(-70deg) translate(8px, -6px); } 100% { transform: none; } }
  @keyframes b-wave { 0%, 100% { transform: none; } 15%, 45%, 75% { transform: rotate(-120deg); } 30%, 60% { transform: rotate(-95deg); } }

  .b-count { position: absolute; top: 8px; right: 2px; min-width: 22px; height: 22px; padding: 0 6px; border-radius: 999px; background: var(--sun-500); color: var(--plum-950); font: 800 12px/22px var(--font-display); text-align: center; box-shadow: 0 0 0 2px #fff; transform: scale(0); transition: transform 0.3s var(--ease); }
  .b-count.on { transform: scale(1); }
  .b-count.pop { animation: b-pop 0.5s var(--ease); }
  @keyframes b-pop { 50% { transform: scale(1.4); } }

  .b-bubble { position: absolute; left: 6px; bottom: calc(100% + 8px); width: max-content; max-width: min(260px, calc(100vw - 40px)); padding: 12px 15px; border-radius: 18px 18px 18px 4px; background: #fff; color: var(--ink); font-size: 14.5px; line-height: 1.45; font-weight: 550; box-shadow: 0 18px 40px -16px rgba(36, 12, 44, 0.45), 0 0 0 1px rgba(36, 12, 44, 0.06); opacity: 0; transform: translateY(8px) scale(0.92); transform-origin: 0 100%; transition: opacity 0.25s, transform 0.35s var(--ease); pointer-events: none; }
  .b-bubble.on { opacity: 1; transform: none; }
  .b-bubble p { margin: 0; }

  .b-tray { position: absolute; left: 0; bottom: calc(100% + 8px); width: min(320px, calc(100vw - 24px)); padding: 16px; border-radius: 20px; background: #fff; box-shadow: 0 26px 60px -20px rgba(36, 12, 44, 0.5), 0 0 0 1px rgba(36, 12, 44, 0.06); }
  .b-tray-h { margin: 0 0 10px; font: 700 16px var(--font-display); color: var(--plum-900); }
  .b-tray-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; max-height: 50vh; overflow: auto; }

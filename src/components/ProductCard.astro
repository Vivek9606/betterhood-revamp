---
import Icon from "./Icon.astro";
import { PRODUCT_BASE, inr } from "../lib/site";
import type { Product } from "../lib/data";

interface Props { product: Product }
const { product: p } = Astro.props;
const off = p.compare && p.compare > p.price ? Math.round((1 - p.price / p.compare) * 100) : 0;
const img = (src: string) => `${src}${src.includes("?") ? "&" : "?"}width=600`;
---
<a class="prod card card-hover" href={PRODUCT_BASE + p.handle} target="_blank" rel="noopener">
  <div class="media prod-media">
    <img src={img(p.image)} alt={p.title} loading="lazy" width="600" height="600" />
    {p.image2 && <img class="alt" src={img(p.image2)} alt="" loading="lazy" width="600" height="600" />}
    {off >= 10 && <span class="badge badge-dark prod-off">-{off}%</span>}
  </div>
  <div class="prod-body">
    <p class="prod-title">{p.title}</p>
    {p.rating && (
      <p class="prod-rate"><Icon name="star" size={15} /> <strong>{p.rating}</strong> <span class="muted">· {p.reviews} review{p.reviews === 1 ? "" : "s"}</span></p>
    )}
    <p class="prod-price"><strong>{inr(p.price)}</strong>{off > 0 && <s>{inr(p.compare!)}</s>}</p>
  </div>
  <span class="prod-cta">Shop now <Icon name="arrow-up-right" size={16} /></span>
</a>

<style>
  .prod { display: flex; flex-direction: column; height: 100%; position: relative; }
  .prod-media { aspect-ratio: 1; background: #f6f1f4; }
  .prod-media img { position: absolute; inset: 0; }
  .prod-media .alt { opacity: 0; transition: opacity 0.4s var(--ease), transform 0.6s var(--ease); }
  .prod:hover .prod-media .alt { opacity: 1; }
  .prod-off { position: absolute; top: 12px; left: 12px; }
  .prod-body { padding: 14px 16px 4px; display: grid; gap: 6px; }
  .prod-title { font-weight: 600; font-size: 15px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 2.7em; }
  .prod-rate { display: flex; align-items: center; gap: 4px; font-size: 13.5px; color: var(--ink); }
  .prod-rate :global(svg) { color: var(--sun-500); }
  .prod-price { display: flex; align-items: baseline; gap: 8px; font-size: 17px; }
  .prod-price s { color: var(--ink-mute); font-size: 14px; }
  .prod-cta { margin: 10px 16px 16px; display: inline-flex; align-items: center; justify-content: center; gap: 6px; padding: 10px; border-radius: var(--r-pill); background: var(--plum-50); color: var(--plum-700); font-weight: 600; font-size: 14.5px; transition: all 0.25s var(--ease); }
  .prod:hover .prod-cta { background: var(--plum-700); color: #fff; }
</style>

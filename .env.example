# Webhook that receives every form submission as JSON (contact, corporate wellness, newsletter,
# waitlists, eBook requests, assessment leads). Leave empty to fall back to a pre-filled email.
PUBLIC_FORM_ENDPOINT=

# Where /wp-content/uploads/... files are served from. Empty = this site (public/wp-content).
PUBLIC_MEDIA_ORIGIN=

# Visitor journey tracking: the backend's collect URL (see backend/README.md). Empty = tracking off.
PUBLIC_TRACK_ENDPOINT=

# Webhook that receives every form submission as JSON (contact, corporate wellness, newsletter,
# waitlists, eBook requests, assessment leads). Leave empty to fall back to a pre-filled email.
PUBLIC_FORM_ENDPOINT=

# Where /wp-content/uploads/... files are served from. Empty = this site (public/wp-content).
PUBLIC_MEDIA_ORIGIN=

# Betterhood API (capacitor-app-backend). Physio directory listings (/physio-directory/join/) are saved there,
# and every build pulls the live ones (scripts/sync-directory.mjs). Add this site's origin to the API's CORS_ORIGINS.
PUBLIC_API_URL=

# Where the Betterhood app's web build is hosted (optional). Shown to physios after they publish a listing.
PUBLIC_APP_URL=
